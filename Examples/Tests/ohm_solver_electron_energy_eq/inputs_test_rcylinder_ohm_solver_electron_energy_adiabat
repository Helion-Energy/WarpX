# RCYLINDER QDSMC electron-energy adiabat CI test.
# Uniform initial entropy + radial ion velocity perturbation. With sources off,
# entropy-conserving transport requires
#   T_e(r,t) = T_e0 * (n(r,t)/n0)^(gamma-1)
# in the interior. Analysis masks near-axis and near-wall cells.
#
# Exercises cylindrical volume weighting of QDSMC markers
# (N_e = n_e * 2 π r Δr) when markers move across radii.

max_step = 80
amr.n_cell = 64
amr.max_level = 0
amr.blocking_factor = 8
amr.max_grid_size = 64

geometry.dims = RCYLINDER
geometry.prob_lo = 0.0
geometry.prob_hi = 0.5

boundary.field_lo = none
boundary.field_hi = pec
boundary.particle_lo = none
boundary.particle_hi = reflecting

warpx.const_dt = 1.0e-9
warpx.cfl = -1.
warpx.serialize_initial_conditions = 1
warpx.verbose = 1
warpx.do_initial_div_cleaning = false

algo.maxwell_solver = hybridPIC
algo.particle_shape = 1
algo.current_deposition = direct
algo.particle_pusher = boris

my_constants.n0 = 2.0e20
my_constants.Te0_eV = 100.0
my_constants.Ti0_eV = 10.0
my_constants.gamma_e = 1.6666666666666667
my_constants.cs = sqrt(gamma_e * q_e * Te0_eV / m_p)
my_constants.V0 = 0.15 * cs
my_constants.k_wave = 2.0 * pi / 0.5

particles.species_names = ions
particles.do_tiling = true

ions.charge = q_e
ions.mass = m_p
ions.injection_style = NUniformPerCell
ions.num_particles_per_cell_each_dim = 64 1
ions.radial_numpercell_power = 1.0
ions.profile = constant
ions.density = n0
ions.momentum_distribution_type = gaussian
ions.ux_mean_function(x,y,z) = "V0 * sin(k_wave * x) / clight"
ions.uy_mean_function(x,y,z) = 0.0
ions.uz_mean_function(x,y,z) = 0.0
ions.ux_th = "sqrt(Ti0_eV * q_e / m_p) / clight"
ions.uy_th = "sqrt(Ti0_eV * q_e / m_p) / clight"
ions.uz_th = "sqrt(Ti0_eV * q_e / m_p) / clight"

hybrid_pic_model.elec_temp = Te0_eV
hybrid_pic_model.gamma = gamma_e
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.n_floor = 0.05 * n0
hybrid_pic_model.substeps = 10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.plasma_hyper_resistivity(rho,B) = 0.0
hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.include_joule_heating = 0

diagnostics.diags_names = diag1
diag1.intervals = 20
diag1.diag_type = Full
diag1.fields_to_plot = rho Te Bt
diag1.format = plotfile
diag1.file_prefix = diags/diag
