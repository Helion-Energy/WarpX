# Explicit hybrid/QDSMC setup for native conduction boundary tests.
# The native fixtures hold B and density fixed and call the FD operator directly.
# max_step can be overridden for an end-to-end explicit PC smoke test.
algo.evolve_scheme = explicit
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.particle_shape = 1
max_step = 0
amr.max_grid_size = 8
amr.max_level = 0
amr.n_cell = 16 32
amr.blocking_factor = 8
geometry.dims = RZ
geometry.prob_lo = 0.0 -0.5
geometry.prob_hi = 0.25 0.5
boundary.field_lo = none pec
boundary.field_hi = pec pec
boundary.particle_lo = none reflecting
boundary.particle_hi = reflecting reflecting
warpx.B_ext_grid_init_style = parse_b_ext_grid_function
warpx.Bx_external_grid_function(x,y,z) = 0
warpx.By_external_grid_function(x,y,z) = 0
warpx.Bz_external_grid_function(x,y,z) = 0.1
warpx.const_dt = 1e-9
warpx.random_seed = 12345
warpx.serialize_initial_conditions = 1
warpx.use_filter = 0
warpx.verbose = 0
warpx.n_rz_azimuthal_modes = 1
diagnostics.enable = 0
hybrid_pic_model.deterministic_pressure_bc = 1
hybrid_pic_model.elec_temp = 100
hybrid_pic_model.gamma = 1.6666666666666667
hybrid_pic_model.n0_ref = 2e18
hybrid_pic_model.n_floor = 1e17
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0
hybrid_pic_model.qdsmc_te_n_floor = 1e14
hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.qdsmc_time_advance = pc
hybrid_pic_model.substeps = 2
hybrid_pic_model.density_pedestal = 1
hybrid_pic_model.density_pedestal_track_floor = 1
hybrid_pic_model.qdsmc_kappa_par(n,Te,t) = "1.5*1.380649e-23*100*n"
hybrid_pic_model.qdsmc_kappa_perp(n,Te,t) = "1.5*1.380649e-23*100*n"
hybrid_pic_model.qdsmc_conduction_operator = fd
hybrid_pic_model.qdsmc_conduction_fd_order = 2
hybrid_pic_model.qdsmc_conduction_fd_limiter = ssmart
hybrid_pic_model.qdsmc_conduction_fd_rtol = 1e-6
hybrid_pic_model.qdsmc_conduction_fd_atol = 1e-9
hybrid_pic_model.qdsmc_conduction_fd_max_subcycles = 30000
hybrid_pic_model.include_joule_heating = 0
particles.species_names = ions
ions.density = 2e18
ions.initialize_self_fields = 0
ions.injection_style = nuniformpercell
ions.momentum_distribution_type = constant
ions.num_particles_per_cell_each_dim = 2 2 2
ions.profile = constant
ions.species_type = proton
ions.ux = 0
ions.uy = 0
ions.uz = 0
