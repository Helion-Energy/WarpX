# Opal energy sharing for MCC electron-impact ionization.
#
# A cold, monoenergetic electron beam ionizes a neutral background. The
# energy left after paying the ionization cost is shared between the incident
# electron and the one it ejects by sampling the Opal secondary-electron
# distribution, so the outgoing energies must follow that distribution rather
# than both being half of what is available.
#
# Nothing but the collisions can change an electron's energy: the fields are
# not evolved and the domain is periodic, so every electron either still
# carries its initial energy or carries the share it was given by exactly one
# ionization event.
#
# That "exactly one" is what the cross section enforces. It is synthetic and
# nonzero only in a narrow window around the beam energy: zero at and below
# 180 eV, 1e-16 m^2 from 190 to 210 eV, and zero again at and above 220 eV.
# The most energetic possible outgoing electron carries E_elec - E_ioniz =
# 180 eV, where the cross section is already zero, so no electron can collide
# twice and the sample stays one generation deep. The upper cutoff matters
# separately, because get_nu_max scans out to 5000 eV whatever the tabulated
# range and reuses the last value above it, so a cross section left flat at
# the end of its grid would inflate the collision majorant and trip the dt
# accuracy warning.

my_constants.n_gas = 1.0e18     # m^-3, neutral fill
my_constants.n_elec = 1.0e16    # m^-3, initial electrons
my_constants.T_gas = 300.0      # K
my_constants.E_elec = 200.0     # eV, initial electron energy
my_constants.v_elec = sqrt(2.0*E_elec*q_e/m_e)

#################################
####### GENERAL PARAMETERS ######
#################################
# Ten steps at an 8% ionization probability each leaves a little over half of
# the beam collided, which is enough events for the distribution check while
# keeping an uncollided population to read the initial energy back from.
max_step = 10
amr.n_cell = 64
amr.max_level = 0
amr.blocking_factor = 8
amr.max_grid_size = 32

geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = 0.1

#################################
###### Boundary Condition #######
#################################
boundary.field_lo = periodic
boundary.field_hi = periodic

#################################
############ NUMERICS ###########
#################################
warpx.serialize_initial_conditions = 1
warpx.verbose = 1
warpx.const_dt = 1.0e-10
warpx.use_filter = 0

# Do not evolve the E and B fields: the electrons then keep whatever energy
# the collisions leave them with, which is what the analysis relies on
algo.maxwell_solver = none

algo.particle_shape = 1

#################################
############ PLASMA #############
#################################
particles.species_names = electrons ions

# Cold and monoenergetic, so that every collision starts from the same
# available energy and the outgoing distribution is not smeared by a spread
# in the incident energy
electrons.species_type = electron
electrons.injection_style = nuniformpercell
electrons.num_particles_per_cell_each_dim = 200
electrons.profile = constant
electrons.density = n_elec
electrons.momentum_distribution_type = constant
electrons.ux = 0.0
electrons.uy = 0.0
electrons.uz = v_elec/clight

# Ionization product; starts empty, so the number of ions present is the
# number of ionization events that have occurred.
# Mass and charge are given directly rather than via species_type, which
# would warn about the charge being overridden.
ions.mass = m_p
ions.charge = q_e
ions.injection_style = none

#################################
############ COLLISION ##########
#################################
collisions.collision_names = coll_elec
coll_elec.type = background_mcc
coll_elec.species = electrons
coll_elec.background_density = n_gas
coll_elec.background_temperature = T_gas
coll_elec.scattering_processes = ionization
coll_elec.ionization_energy = 20.0
coll_elec.ionization_cross_section = ../../../Examples/Tests/mcc_opal_energy_sharing/ionization_window.dat
coll_elec.ionization_species = ions

# Share the available energy according to Opal rather than equally
coll_elec.ionization_energy_sharing = opal
coll_elec.ionization_opal_w = 10.0

#################################
########### DIAGNOSTICS #########
#################################
diagnostics.diags_names = diag1

diag1.intervals = 10
diag1.diag_type = Full
diag1.format = openpmd
diag1.fields_to_plot = none
diag1.species = electrons ions
