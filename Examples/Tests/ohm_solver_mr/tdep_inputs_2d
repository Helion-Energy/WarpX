# Hybrid-PIC MR temperature-deposition smoke (Q1 follow-up):
# copy of t_smoke_inputs_2d with the shape-matched, bias-removed
# two-pass temperature deposition enabled for the ions and the deposited
# per-direction temperatures (K) added to the plotfile output.
# Run pair (mpirun --bind-to none -np 2 each):
#   <warpx.2d> tdep_inputs_2d                    # MR arm
#   <warpx.2d> tdep_inputs_2d amr.max_level=0    # single-level control
# Analyze with t_tdep_analyze.py.
#
# NOTE (2026-08-06): two temperature-deposition bugs were found with
# this deck and FIXED in source:
#  1) TemperatureDeposition.H used lo.z (dummy, always 0) instead of
#     lo.y for the z index in the 2D XZ/RZ branch (and lo.z instead of
#     lo.x in 1D), collapsing every tile/box deposit onto its fab's
#     z-origin rows -> silent heap underflow, garbage T, MR segfaults.
#  2) AccumulateVelocitiesAndComputeTemperature called the all-level
#     ConvertVarianceToTemperatureAndFilter inside the level loop ->
#     level 0 double-normalized (x m/kB twice) and double-filtered in
#     MR runs.
# The outermost fine-cell row at the patch boundary (half shape
# support) still produces unreliable T spikes; mask it in analysis.
#
# NOTE: the first DepositTemperatures call happens at the start of
# Evolve (HybridPICInitializeRhoJandB), i.e. AFTER the step-0 diag
# flush, so the step-0 plotfile has T_<species> = 0. The step-1 dump
# below serves as the t~0 deposited-T snapshot.

max_step = 300
warpx.const_dt = 5.685630111305193e-12
warpx.verbose = 1

amr.n_cell = 32 256
amr.max_level = 1
amr.blocking_factor = 4
amr.max_grid_size = 128
warpx.fine_tag_lo = -2.2840138279820255e-3 0.018
warpx.fine_tag_hi =  2.2840138279820255e-3 0.055

geometry.dims = 2
geometry.prob_lo = -4.5680276559640510e-3 0.0
geometry.prob_hi =  4.5680276559640510e-3 0.073088442495424816

boundary.field_lo = periodic periodic
boundary.field_hi = periodic periodic
boundary.particle_lo = periodic periodic
boundary.particle_hi = periodic periodic

algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.particle_shape = 1

hybrid_pic_model.elec_temp = 510.998950691753
hybrid_pic_model.gamma = 1.0
hybrid_pic_model.n0_ref = 9.623617654281555e20
hybrid_pic_model.plasma_resistivity(rho,J,t) = 1e-07
hybrid_pic_model.substeps = 20

# uniform background field (trivially divergence free)
warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.0 0.0 0.1

particles.species_names = ions
ions.charge = q_e
ions.mass = 9.1093837139e-29
ions.injection_style = nrandompercell
ions.num_particles_per_cell = 4
ions.profile = parse_density_function
ions.density_function(x,y,z) = "9.623617654281555e20*(1+0.03*cos(343.86751681418855*z))"
ions.momentum_distribution_type = gaussian
ions.ux_th = 0.001
ions.uy_th = 0.001
ions.uz_th = 0.001

# shape-matched two-pass temperature deposition (bias-removed variance)
ions.do_temperature_deposition = 1

diagnostics.diags_names = diag1
diag1.diag_type = Full
diag1.format = plotfile
diag1.intervals = 0:1,50:300:50
diag1.fields_to_plot = Bx By Bz Ex Ey Ez jx jy jz rho divB Tx_ions Ty_ions Tz_ions
diag1.write_species = 1

warpx.reduced_diags_names = field_energy part_energy
field_energy.type = FieldEnergy
field_energy.intervals = 5
part_energy.type = ParticleEnergy
part_energy.intervals = 5

warpx.serialize_initial_conditions = 1
