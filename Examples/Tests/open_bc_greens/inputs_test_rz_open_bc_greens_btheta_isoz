# Isolated-z variant of test 3: same axial current column, but with PEC z
# faces instead of periodic z. This exercises the isolated-z kernel branch
# (no periodic image sum) and the non-periodic B_theta corner clamp of the
# ghost fill. The relaxed B_theta must still match Ampere's law and stay
# z-uniform (the poloidal current column and its toroidal field are
# unaffected by the z-face conductor).
FILE = inputs_base_rz_open_bc_greens

geometry.prob_lo = 0.0 -0.5
geometry.prob_hi = 1.0  0.5
amr.n_cell = 32 32

boundary.field_lo = none pec
boundary.field_hi = open pec

# Gaussian axial current column J_z(r) = J0 exp(-r^2/a^2), a = 0.15
hybrid_pic_model.Jz_external_grid_function(x,y,z,t) = "1.0e3 * exp(-(x/0.15)^2)"

boundary.open_bc_coarsening = 4
