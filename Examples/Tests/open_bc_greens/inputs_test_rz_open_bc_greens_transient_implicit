# Theta-implicit arm of the temporal-coupling guard: with the Green's ghost
# fill inside every residual evaluation, the theta-midpoint one-step-per-dt
# transient must land on the explicit subcycled trajectory to integrator
# truncation order. A lagged (delivered-state-only) fill fails by orders of
# magnitude with a substep-scale boundary reflection, exactly like the
# explicit lagged variant the design doc forbids.
FILE = inputs_test_rz_open_bc_greens_transient_sub80

algo.evolve_scheme = "theta_implicit_hybrid"
implicit_evolve.theta = 0.5

implicit_evolve.nonlinear_solver = "newton"
newton.verbose = true
newton.max_iterations = 20
newton.relative_tolerance = 1.0e-8
newton.absolute_tolerance = 0.0
newton.require_convergence = true

gmres.verbose_int = 1
gmres.max_iterations = 100
gmres.relative_tolerance = 1.0e-6
gmres.absolute_tolerance = 0.0
