#################################
############ CONSTANTS ##########
#################################

my_constants.n0 = 1.0e20
my_constants.rho0 = n0 * m_p
my_constants.Te = 10.0
my_constants.Ti = 10.0
my_constants.Pe = n0 * Te * q_e
my_constants.Pi = n0 * Ti * q_e
my_constants.gamma = 5.0/3.0
my_constants.B0 = 0.01
my_constants.uref = 1.0e4
my_constants.Lr = 0.08
my_constants.Lz = 0.4
my_constants.nr = 16
my_constants.nz = 32
my_constants.pulse = 2.0
my_constants.eta0 = 1.0e-5
my_constants.w = 0.05
my_constants.wr = 0.05
my_constants.sound_speed = sqrt(gamma*(Pe+Pi)/rho0)
my_constants.alfven_speed = B0 / sqrt(mu0*rho0)
my_constants.dt = 0.25 * (Lz/nz) / (sound_speed + alfven_speed)

#################################
####### GENERAL PARAMETERS ######
#################################

# Mirror-symmetry z_lo boundary (boundary.field_lo = pmc on z paired
# with implicit_mhd.z_lo_boundary_fluid = symmetry): the HALF-domain
# twin of test_rz_theta_implicit_mhd_mirror_full, z in [0, Lz] at the
# identical resolution, same symmetric pulse. The analysis (which
# depends on the full run) asserts the gold standard: the half-domain
# fields and moments match the full run's upper half to solver
# roundoff, the half-domain mass is conserved to roundoff before
# anything reaches the z_hi outflow end, and the tangential B / axial
# velocity at the plane are mirror-parity consistent.
max_step = 32
amr.n_cell = nr nz
amr.max_grid_size = 64
amr.max_level = 0

geometry.dims = RZ
warpx.n_rz_azimuthal_modes = 1
geometry.prob_lo = 0.0 0.0
geometry.prob_hi = Lr Lz
boundary.field_lo = none pmc
boundary.field_hi = pec none
boundary.particle_lo = none reflecting
boundary.particle_hi = reflecting absorbing

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5

# Deep convergence: see the full-domain reference deck.
newton.verbose = true
newton.absolute_tolerance = 0.0
newton.relative_tolerance = 1.0e-12
newton.max_iterations = 20
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-12
gmres.max_iterations = 300

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Te
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
# Small uniform resistivity: mirror-parity consistent (eta J), keeps
# the resistive Ohm channel and the block preconditioner's
# resistive rows live at the mirror plane.
hybrid_pic_model.plasma_resistivity(rho,J,t) = eta0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_velocity = uref
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = Pi
implicit_mhd.ion_closure = total_energy
implicit_mhd.mass_density_floor = 1.0e-4 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-4 * Pe
implicit_mhd.ion_pressure_floor = 1.0e-4 * Pi
implicit_mhd.fluid_flux = hlld
implicit_mhd.z_boundary_fluid = outflow
implicit_mhd.z_lo_boundary_fluid = symmetry
# Same symmetric adiabatic blob as the full-domain reference (the half
# domain sees its upper half; the cell centers are bitwise identical).
implicit_mhd.mass_density(x,y,z) = rho0 * (1.0 + pulse*exp(-(z/w)^2 - (x/wr)^2))
implicit_mhd.electron_pressure(x,y,z) = Pe * (1.0 + pulse*exp(-(z/w)^2 - (x/wr)^2))
implicit_mhd.ion_pressure(x,y,z) = Pi * (1.0 + pulse*exp(-(z/w)^2 - (x/wr)^2))
# Even azimuthal flow (vanishing on the axis) so every parity channel
# goes live: with uniform Bz the flow induces E_r = -u_theta Bz (even),
# whose z-gradient winds up an ODD Btheta within a few steps, and with
# it jr/jt (even), jz/Ez (odd) -- the full mirror parity table is
# nonzero by the final output.
implicit_mhd.velocity_y(x,y,z) = uref * (x/wr) * exp(-(z/w)^2 - (x/wr)^2)

warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.0 0.0 B0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 32
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Br Bt Bz Er Et Ez jr jt jz \
                       implicit_mhd_mass_density \
                       implicit_mhd_electron_energy \
                       implicit_mhd_ion_energy \
                       implicit_mhd_momentum_r \
                       implicit_mhd_momentum_t \
                       implicit_mhd_momentum_z
diag1.write_species = 0
