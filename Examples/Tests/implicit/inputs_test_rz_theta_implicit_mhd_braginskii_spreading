#################################
############ CONSTANTS ##########
#################################

# Anisotropic Braginskii electron conduction in a strongly magnetized
# uniform Bz: a hot Gaussian electron-temperature spot on the axis must
# spread along B (chi_par_e(Te0, n0) ~ 6.05e6 m^2/s) while staying
# frozen across it (Omega_e tau_e ~ 9.6e3, so
# chi_perp/chi_par ~ 1.6e-8): the z-profile variance grows at
# d sigma_z^2/dt = 2 chi_par while the r-variance growth is capped near
# zero. Ions are frozen (barotropic closure, evolve_ion_fluid = false)
# and the electromagnetic subsystem is quiescent (uniform Bz, J = 0,
# eta = 0), so the run isolates the tensor conduction channel.
my_constants.n0 = 1.0e18
my_constants.rho0 = n0 * m_p
my_constants.Te0 = 10.0
my_constants.Pe0 = n0 * Te0 * q_e
my_constants.gamma = 5.0/3.0
my_constants.B0 = 0.05
my_constants.nr = 24
my_constants.nz = 48
my_constants.Lr = 0.6
my_constants.Lz = 1.0
# Gaussian spot: half-width w, small amplitude (near-linear diffusion)
my_constants.w = 0.1
my_constants.dTe = 0.02
# ~doubles sigma_z^2 = w^2/2 over 10 steps: t_tot = (w^2/2)/(2 chi_par)
my_constants.dt = 4.13e-11

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 10
amr.n_cell = nr nz
amr.max_grid_size = 24
amr.max_level = 0

geometry.dims = RZ
geometry.prob_lo = 0.0 -0.5*Lz
geometry.prob_hi = Lr 0.5*Lz
boundary.field_lo = none periodic
boundary.field_hi = pec periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5

newton.verbose = true
newton.absolute_tolerance = 1.0e-12
newton.relative_tolerance = 1.0e-10
newton.max_iterations = 20
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-10
gmres.max_iterations = 300

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Te0
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = 0.0
implicit_mhd.mass_density_floor = 1.0e-6 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-6 * Pe0
implicit_mhd.evolve_ion_fluid = false
implicit_mhd.fluid_flux = central
# required by the central flux; inert here (u = 0, frozen ions)
implicit_mhd.viscosity = 0.5
implicit_mhd.thermal_conduction_model = braginskii
implicit_mhd.conduction_coulomb_log = 10.0
implicit_mhd.mass_density(x,y,z) = rho0
implicit_mhd.electron_pressure(x,y,z) = \
    "Pe0*(1.0 + dTe*exp(-(x*x + z*z)/(w*w)))"

# A uniform axial field keeps the electromagnetic subsystem quiescent
# (u = 0, eta = 0, J = 0) and defines the parallel (z) direction.
warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.0 0.0 B0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 10
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Bz implicit_mhd_mass_density \
                       implicit_mhd_electron_energy
diag1.write_species = 0
