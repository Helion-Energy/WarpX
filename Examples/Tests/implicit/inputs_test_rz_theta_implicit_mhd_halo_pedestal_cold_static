implicit_mhd.halo_pedestal_density = n_static
# (T_ped_e is 2 eV in the base deck already; redefine the ion constant the
# base's key line reads)
my_constants.T_ped_i = 2.0
implicit_mhd.halo_pedestal_cold_raise = floor
