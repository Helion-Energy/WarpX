#################################
############ CONSTANTS ##########
#################################

my_constants.n0 = 1.0e20
my_constants.rho0 = n0 * m_p
my_constants.Ti = 100.0
my_constants.P0 = n0 * Ti * q_e
my_constants.pe0 = 0.75 * P0
my_constants.gamma = 5.0/3.0
# Hyper-resistive decay of a transverse standing perturbation: with no
# guide field and u = 0, Bx = b cos(kz) is contact-inert for the hlld
# fan (the tangential-discontinuity class, exact through the assembly),
# and the ONLY dynamics is E = -eta_H laplacian(J). The composite Yee
# operator damps the mode at exactly gamma_d = eta_H kd^4 / mu0 with
# the discrete wavenumber kd = (2/dz) sin(k dz/2), and the theta scheme
# multiplies the amplitude per step by
#   g = (1 - (1-theta) gamma_d dt) / (1 + theta gamma_d dt).
# The perturbation is kept small so the O(b^2) magnetic-pressure fluid
# response stays far below the calibration tolerance.
my_constants.b0 = 1.0e-5
my_constants.nz = 64
my_constants.Lz = 1.6
my_constants.dz = Lz / nz
my_constants.kz = 2 * pi / Lz
my_constants.kd = 2 * sin(kz * dz / 2) / dz
my_constants.eta_h = 0.5
my_constants.gamma_d = eta_h * kd^4 / mu0
# gamma_d dt = 0.1 per step
my_constants.dt = 0.1 / gamma_d

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 40
amr.n_cell = nz
amr.max_grid_size = 32
amr.max_level = 0

geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = Lz
boundary.field_lo = periodic
boundary.field_hi = periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5

newton.verbose = true
newton.absolute_tolerance = 1.0e-12
newton.relative_tolerance = 1.0e-10
newton.max_iterations = 20

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-10
gmres.max_iterations = 400

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Ti
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.plasma_hyper_resistivity(rho,B) = eta_h
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = sqrt(mu0 * P0)
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = P0
implicit_mhd.ion_closure = total_energy
implicit_mhd.ion_pressure_floor = 1.0e-6 * P0
implicit_mhd.mass_density_floor = 1.0e-6 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-9 * P0
implicit_mhd.fluid_flux = hlld
implicit_mhd.mass_density(x,y,z) = "rho0"
implicit_mhd.ion_pressure(x,y,z) = "P0"
implicit_mhd.electron_pressure(x,y,z) = "pe0"

warpx.B_ext_grid_init_style = parse_b_ext_grid_function
warpx.Bx_external_grid_function(x,y,z) = "b0 * cos(kz * z)"
warpx.By_external_grid_function(x,y,z) = "0.0"
warpx.Bz_external_grid_function(x,y,z) = "0.0"

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 40
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Bx By Bz implicit_mhd_mass_density \
                       implicit_mhd_ion_energy implicit_mhd_electron_energy
diag1.write_species = 0
