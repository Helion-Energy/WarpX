#################################
############ CONSTANTS ##########
#################################

# RZ dense column + sub-pedestal halo under the COLD pedestal image
# (implicit_mhd.halo_pedestal_temperature_e / _i) with the production
# fluid stack of the formation deck: dual_energy closure, central flux
# with viscous stabilization, theta = 1, Braginskii conduction with the
# usual caps, the pedestal drag and ion-energy relaxation, an axial
# external field (field lines along z: the halo is conductively
# decoupled from the core except through the capped perpendicular
# channel). The halo (r > ~0.047 m, 78 % of the volume) is loaded two
# decades BELOW the pedestal and HOT (300 eV) at 1e-5 of the core
# density, so the first refresh raises it onto the pedestal and the
# cold image REMOVES electron heat (n_halo T_halo = 3e-3 n0 eV > n_ped
# T_ped_e = 2e-3 n0 eV) while it ADDS ion heat (n_ped T_ped_i = 2e-2 n0
# eV): both ledger signs are exercised. Periodic in z, reflecting outer
# wall, no wall drain: the domain mass changes ONLY through the refresh,
# so the ledger's injected mass must close against the domain mass
# change, and the cold band must stay near the cold image over the run
# (the peak image would put it at the core temperature, 25x hotter).
my_constants.n0 = 1.0e19
my_constants.rho0 = n0 * m_p
my_constants.T0_ev = 50.0
my_constants.Thalo_ev = 300.0
my_constants.T_ped_e = 2.0
my_constants.T_ped_i = 20.0
my_constants.f_ped = 1.0e-3
my_constants.halo = 1.0e-5
my_constants.gamma = 5.0/3.0
my_constants.B0 = 0.05
my_constants.Lr = 0.1
my_constants.Lz = 0.4
my_constants.nr = 16
my_constants.nz = 32
my_constants.redge = 0.03
my_constants.rwidth = 0.005
my_constants.chi_cap = 4.0e4
my_constants.dt = 2.0e-9
my_constants.nu_ped = 1.0e7
# Profiles (inlined below; the parser takes no user functions): density
# shape(x) = halo + (1-halo)*0.5*(1-tanh((x-redge)/rwidth)) -- core rho0,
# tanh edge at redge, halo floor at halo*rho0 -- and temperature
# temp(x) = T0 + (Thalo - T0)*0.5*(1+tanh((x-redge)/rwidth)).

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 8
amr.n_cell = nr nz
amr.max_grid_size = 16
amr.max_level = 0

geometry.dims = RZ
warpx.n_rz_azimuthal_modes = 1
geometry.prob_lo = 0.0 -0.5*Lz
geometry.prob_hi = Lr 0.5*Lz
boundary.field_lo = none periodic
boundary.field_hi = pec periodic
boundary.particle_lo = none periodic
boundary.particle_hi = reflecting periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 1.0

newton.verbose = true
newton.absolute_tolerance = 1.0e-11
newton.relative_tolerance = 1.0e-8
newton.max_iterations = 20
newton.require_convergence = false
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-9
gmres.max_iterations = 300

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = T0_ev
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = n0 * T0_ev * q_e
implicit_mhd.mass_density_floor = 1.0e-6 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-6 * n0 * T0_ev * q_e
implicit_mhd.ion_pressure_floor = 1.0e-6 * n0 * T0_ev * q_e
implicit_mhd.fluid_flux = central
implicit_mhd.viscosity = 0.5
implicit_mhd.ion_closure = dual_energy
implicit_mhd.thermal_conduction_model = braginskii
implicit_mhd.conduction_coulomb_log = 10.0
implicit_mhd.conduction_chi_par_max = chi_cap
implicit_mhd.conduction_chi_perp_max = chi_cap
implicit_mhd.mass_density(x,y,z) = rho0 * (halo + (1-halo)*0.5*(1-tanh((x-redge)/rwidth)))
implicit_mhd.electron_pressure(x,y,z) = n0 * (halo + (1-halo)*0.5*(1-tanh((x-redge)/rwidth))) * (T0_ev + (Thalo_ev - T0_ev)*0.5*(1+tanh((x-redge)/rwidth))) * q_e
implicit_mhd.ion_pressure(x,y,z) = n0 * (halo + (1-halo)*0.5*(1-tanh((x-redge)/rwidth))) * (T0_ev + (Thalo_ev - T0_ev)*0.5*(1+tanh((x-redge)/rwidth))) * q_e
# The pedestal machinery as the production deck runs it, with the cold
# image under test and the refresh ledger.
implicit_mhd.halo_pedestal_fraction = f_ped
implicit_mhd.halo_pedestal_drag_rate = nu_ped
implicit_mhd.halo_pedestal_energy_rate = nu_ped
implicit_mhd.halo_pedestal_temperature_e = T_ped_e
implicit_mhd.halo_pedestal_temperature_i = T_ped_i
implicit_mhd.halo_pedestal_ledger_file = diags/halo_pedestal_ledger.txt

warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.0 0.0 B0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 8
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Bz implicit_mhd_mass_density \
                       implicit_mhd_electron_energy implicit_mhd_ion_energy \
                       implicit_mhd_ion_internal_energy \
                       implicit_mhd_momentum_r implicit_mhd_momentum_t \
                       implicit_mhd_momentum_z \
                       implicit_mhd_pedestal_injected_mass \
                       implicit_mhd_pedestal_injected_electron_energy \
                       implicit_mhd_pedestal_injected_ion_energy
diag1.write_species = 0
