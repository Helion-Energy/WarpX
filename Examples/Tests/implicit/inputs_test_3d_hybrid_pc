# Frozen-operator Hall wave test; no time advance or field diagnostics.
geometry.dims = 3
geometry.prob_lo = 0 0 0
geometry.prob_hi = 1 1 1
amr.n_cell = 8 8 8
amr.max_grid_size = 8
amr.blocking_factor = 4
amr.max_level = 0
boundary.field_lo = periodic periodic periodic
boundary.field_hi = periodic periodic periodic
boundary.particle_lo = periodic periodic periodic
boundary.particle_hi = periodic periodic periodic
algo.maxwell_solver = hybrid
algo.evolve_scheme = theta_implicit_hybrid
algo.particle_shape = 1
algo.current_deposition = direct
implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5
implicit_evolve.use_mass_matrices_jacobian = 0
implicit_evolve.use_mass_matrices_pc = 0
newton.linear_solver = amrex_fgmres
jacobian.pc_type = none
hybrid_pic_model.elec_temp = 0.5
hybrid_pic_model.n0_ref = 1.e16
hybrid_pic_model.n_floor = 1.e14
hybrid_pic_model.gamma = 1.6666666666666667
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
particles.species_names = ions
ions.species_type = proton
ions.injection_style = nuniformpercell
ions.num_particles_per_cell_each_dim = 1 1 1
ions.profile = constant
ions.density = 1.e16
ions.momentum_distribution_type = constant
ions.ux = 0
ions.uy = 0
ions.uz = 0
warpx.const_dt = 1.e-9
warpx.use_filter = 0
warpx.verbose = 0
warpx.random_seed = 12345
max_step = 0
diagnostics.enable = 0
