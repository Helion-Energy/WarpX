#################################
############ CONSTANTS ##########
#################################

# Ion-target valve mode of the windowed halo relaxation outlet
# (implicit_mhd.halo_relaxation_target = ion): the reference code's te <= tm cap
# (vp.f90:731) in relaxed, JFNK-safe form. A COMPLETELY UNIFORM
# sub-window column (n = 1e18 << n_max, Te = 100 eV, Ti = 5 eV,
# uniform transverse slip v0) has zero gradients, so the electron
# drain toward the LOCAL frozen ion-temperature image
# n kB Ti / (gamma_e - 1) is the ONLY dynamics:
#   * U_e decays toward the 5 eV image at EXACTLY the
#     theta-discretized rate (the one-sided gate is identically 1 at
#     20x the target);
#   * the ion channel is UNTOUCHED (the valve caps electrons only), so
#     E_i, the momentum, and the density must stay invariant -- which
#     also keeps the frozen per-step target constant;
#   * the ledger closes against the domain electron-energy loss.
my_constants.n0 = 1.0e18
my_constants.n_max = 1.0e19
my_constants.rho0 = n0 * m_p
my_constants.Te = 100.0
my_constants.Ti = 5.0
my_constants.Pe = n0 * Te * q_e
my_constants.Pi = n0 * Ti * q_e
my_constants.v0 = 2.0e4
my_constants.nu = 5.0e6
my_constants.nz = 64
my_constants.Lz = 1.0
my_constants.dt = 1.0e-9

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 8
amr.n_cell = nz
amr.max_grid_size = nz
amr.max_level = 0

geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = Lz
boundary.field_lo = periodic
boundary.field_hi = periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5

newton.verbose = true
newton.absolute_tolerance = 1.0e-12
newton.relative_tolerance = 1.0e-11
newton.max_iterations = 8
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-11
gmres.max_iterations = 200

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Te
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.n_floor = 1.0e8
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = 1.0e-4
implicit_mhd.gamma_e = 5.0/3.0
implicit_mhd.gamma_i = 5.0/3.0
implicit_mhd.reference_ion_pressure = Pi
implicit_mhd.mass_density(x,y,z) = rho0
implicit_mhd.electron_pressure(x,y,z) = Pe
implicit_mhd.ion_pressure(x,y,z) = Pi
implicit_mhd.velocity_x(x,y,z) = v0
implicit_mhd.evolve_ion_fluid = true
implicit_mhd.fluid_flux = central
# The central flux requires the explicit viscous stabilization (the
# production pairing); the uniform slip has zero shear, so it is inert
# away from the contacts.
implicit_mhd.viscosity = 3000.0
implicit_mhd.include_joule_heating = true
implicit_mhd.ion_closure = total_energy
implicit_mhd.electron_pressure_floor = 1.0e-8
implicit_mhd.ion_pressure_floor = 1.0e-8
# The ion-target valve under test (T_med is unused in this mode).
implicit_mhd.halo_relaxation_rate = nu
implicit_mhd.halo_relaxation_target = ion
implicit_mhd.halo_relaxation_n_max = n_max
implicit_mhd.halo_relaxation_ledger_file = halo_relaxation_ledger.txt

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 8
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Ex Ey Ez Bx By Bz \
                       implicit_mhd_mass_density implicit_mhd_momentum_density \
                       implicit_mhd_electron_energy implicit_mhd_ion_energy
diag1.write_species = 0
