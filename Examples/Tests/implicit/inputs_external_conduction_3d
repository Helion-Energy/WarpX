# Native conduction fixture; standalone probe supplies the manufactured temperature.
geometry.dims = 3
geometry.prob_lo = -1 -1 -1
geometry.prob_hi = 1 1 1
amr.n_cell = 16 16 16
amr.max_grid_size = 8
amr.blocking_factor = 4
amr.max_level = 0
boundary.field_lo = periodic periodic periodic
boundary.field_hi = periodic periodic periodic
boundary.particle_lo = periodic periodic periodic
boundary.particle_hi = periodic periodic periodic
algo.maxwell_solver = hybrid
algo.evolve_scheme = explicit
algo.particle_shape = 1
algo.current_deposition = direct
hybrid_pic_model.elec_temp = 0.5
hybrid_pic_model.n0_ref = 1.e16
hybrid_pic_model.n_floor = 1.e14
hybrid_pic_model.gamma = 1.6666666666666667
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
particles.species_names = ions
ions.species_type = proton
ions.injection_style = nuniformpercell
ions.num_particles_per_cell_each_dim = 1 1 1
ions.profile = constant
ions.density = 1.e16
ions.momentum_distribution_type = constant
ions.ux = 0
ions.uy = 0
ions.uz = 0
warpx.const_dt = 1.e-5
warpx.use_filter = 0
warpx.verbose = 0
warpx.random_seed = 12345
max_step = 1
diagnostics.enable = 0

hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.qdsmc_te_n_floor = 1e14
hybrid_pic_model.qdsmc_kappa_par(n,Te,t) = "1.5*1.380649e-23*n*100"
hybrid_pic_model.qdsmc_kappa_perp(n,Te,t) = "1.5*1.380649e-23*n*1"
hybrid_pic_model.qdsmc_conduction_operator = fd
hybrid_pic_model.qdsmc_conduction_fd_order = 4
hybrid_pic_model.qdsmc_conduction_fd_limiter = ssmart
hybrid_pic_model.qdsmc_conduction_fd_rtol = 1e-6
hybrid_pic_model.qdsmc_conduction_fd_atol = 1e-9
hybrid_pic_model.qdsmc_conduction_fd_max_subcycles = 30000
hybrid_pic_model.include_joule_heating = 0

hybrid_pic_model.qdsmc_conduction_eb_bc = adiabatic

hybrid_pic_model.qdsmc_n_floor = 1e14
hybrid_pic_model.qdsmc_conduction_Te_floor = 0.5
hybrid_pic_model.qdsmc_conduction_fd_cfl = 0.04
hybrid_pic_model.qdsmc_conduction_fd_time = rkl2

geometry.is_periodic = 1 1 1
ions.do_not_push = 1
algo.field_gathering = momentum-conserving
hybrid_pic_model.qdsmc_time_advance = pc
hybrid_pic_model.include_hall_term = 0
hybrid_pic_model.include_electron_pressure_term = 0
hybrid_pic_model.energy_conserving_motional = 0
hybrid_pic_model.include_viscous_heating = 0
hybrid_pic_model.include_hyper_resistive_heating = 0
hybrid_pic_model.qdsmc_conduction_verbose = 1
hybrid_pic_model.substeps = 4
warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0 0 1
hybrid_pic_model.add_external_fields = 0
external_vector_potential.fields = uniform
external_vector_potential.uniform.Ax_external_grid_function(x,y,z) = "-0.5*y"
external_vector_potential.uniform.Ay_external_grid_function(x,y,z) = "0.5*x"
external_vector_potential.uniform.Az_external_grid_function(x,y,z) = "0"
external_vector_potential.uniform.A_time_external_function(t) = "1"
external_vector_potential.do_diva_cleaning = 0
