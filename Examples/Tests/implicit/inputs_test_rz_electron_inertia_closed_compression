# Closed magnetic-pressure compression of a sharp cylinder, periodic along z.
max_step = 10000
amr.n_cell = 32 16
amr.max_grid_size = 16
amr.blocking_factor = 4
amr.max_level = 0
geometry.dims = RZ
geometry.prob_lo = 0 -0.00375
geometry.prob_hi = 0.03 0.00375
boundary.field_lo = none periodic
boundary.field_hi = pec periodic
boundary.particle_lo = none periodic
boundary.particle_hi = reflecting periodic
boundary.verboncoeur_axis_correction = 1
warpx.verbose = 0
warpx.const_dt = 2.e-9
warpx.serialize_initial_conditions = 1
warpx.random_seed = 42317
warpx.use_filter = 1
warpx.filter_npass_each_dir = 4 4
warpx.rz_continuity_filter = 1
warpx.rz_continuity_audit_interval = 1
warpx.abort_on_warning_threshold = high
algo.maxwell_solver = hybrid
algo.evolve_scheme = explicit
algo.particle_shape = 3
algo.current_deposition = esirkepov
hybrid_pic_model.elec_temp = 0
hybrid_pic_model.gamma = 1.6666666666666667
hybrid_pic_model.n0_ref = 1.e21
hybrid_pic_model.n_floor = 5.e19
hybrid_pic_model.density_pedestal = 1
hybrid_pic_model.density_pedestal_profile(x,y,z) = 5.e19
hybrid_pic_model.include_hall_term = 1
hybrid_pic_model.include_electron_pressure_term = 0
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0
hybrid_pic_model.plasma_hyper_resistivity(rho,B) = 0
hybrid_pic_model.include_electron_inertia_elliptic = 1
hybrid_pic_model.electron_inertia_relative_tolerance = 1.e-11
hybrid_pic_model.electron_inertia_max_iterations = 1000
hybrid_pic_model.electron_inertia_convection = 1
hybrid_pic_model.electron_inertia_moment_terms = 1
hybrid_pic_model.electron_inertia_momentum_flux = 1
hybrid_pic_model.substeps = 64
particles.species_names = ions
ions.charge = q_e
ions.mass = m_p
ions.injection_style = NUniformPerCell
ions.num_particles_per_cell_each_dim = 2 4 2
ions.profile = parse_density_function
ions.density_function(x,y,z) = if(x*x+y*y<0.015*0.015,1.e21,0)
ions.momentum_distribution_type = parse_momentum_function
ions.momentum_function_ux(x,y,z) = 0
ions.momentum_function_uy(x,y,z) = 0
ions.momentum_function_uz(x,y,z) = 0
edge_transport.steps = 500
edge_transport.prescribed = 0
edge_transport.energy_relative_tolerance = 0.01
edge_transport.minimum_crossed_cells = 2
my_constants.clight = 299792458
diagnostics.enable = 0

# The native harness seeds a solenoidal Bz(r) pressure profile before stepping.
warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0 0 0.1
edge_transport.magnetic_piston = 1
