#################################
############ CONSTANTS ##########
#################################

my_constants.n0 = 1.0e20
my_constants.rho0 = n0 * m_p
my_constants.Ti = 100.0
my_constants.P0 = n0 * Ti * q_e
my_constants.gamma = 5.0/3.0
my_constants.B0 = sqrt(mu0 * P0)
my_constants.pe0 = 0.25 * P0
# Reversed-field column hold (the infinite-length FRC analogue): Bz(r)
# runs from -B0 on the axis through a field null at r_s = rc sqrt(ln 2)
# to +B0 at the conducting wall, the ELECTRON pressure carries exact
# total-pressure balance pe + Bz^2/2mu0 = pe0 + B0^2/2mu0 (pe peaks at the
# null) with a uniform ion pressure, and the DENSITY steps down across the
# null over ws (an entropy-channel contact riding the separatrix
# analogue, where the production run's closed-flux mass leaks). At u = 0
# (u_pert = 0) the state is an exact equilibrium: the mass inside r_s,
# the "closed-flux mass" of this column, must stay put. The scalar
# fast-speed Rusanov penalty of the central flux diffuses the density
# step and the pe profile at |u_n| + c_f although both sit on the
# entropy wave (speed u_n = 0); the flow-speed penalty is exactly zero
# there. With u_pert > 0 a radial, z-modulated velocity pulse makes the
# solver work (Alfvenic response of the reversed field), for the
# Newton / GMRES comparison of the penalty variants and of the
# zero-dissipation residual with the preconditioner's upwind rows.
my_constants.rc = 0.04
my_constants.rs = rc * sqrt(log(2.0))
my_constants.ws = 0.004
my_constants.rho_ratio = 0.25
my_constants.u_pert = 0.0
my_constants.nr = 32
my_constants.nz = 16
my_constants.Lr = 0.1
my_constants.Lz = 0.2
my_constants.v0 = sqrt(P0/rho0)
my_constants.dt = 0.2 * (Lr/nr) / v0

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 100
amr.n_cell = nr nz
amr.max_grid_size = 32
amr.max_level = 0

geometry.dims = RZ
geometry.prob_lo = 0.0 0.0
geometry.prob_hi = Lr Lz
boundary.field_lo = none periodic
boundary.field_hi = pec periodic

#################################
############ NUMERICS ###########
#################################

# the RZ parse_b_ext_grid style warns (medium) that Br/Btheta
# expressions are ignored in RZ; both are identically zero here, and
# Bz IS evaluated at the staggered radii (x = r in the parser).
warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 1.0

newton.verbose = true
newton.absolute_tolerance = 1.0e-11
newton.relative_tolerance = 1.0e-9
newton.max_iterations = 20
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-9
gmres.max_iterations = 400

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Ti
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = P0
implicit_mhd.ion_closure = total_energy
implicit_mhd.ion_pressure_floor = 1.0e-6 * P0
implicit_mhd.mass_density_floor = 1.0e-6 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-9 * P0
# the production flux stack; the penalty coefficients and speeds are set
# per registration (implicit_mhd.central_dissipation*)
implicit_mhd.fluid_flux = central
implicit_mhd.viscosity = 0.5
implicit_mhd.fluid_reconstruction = median
implicit_mhd.mass_density(x,y,z) = \
    "rho0 * (rho_ratio + (1.0 - rho_ratio) * 0.5 * (1.0 - tanh((x - rs)/ws)))"
implicit_mhd.ion_pressure(x,y,z) = "P0"
implicit_mhd.electron_pressure(x,y,z) = \
    "pe0 + (B0*B0 - (B0*(1.0 - 2.0*exp(-(x/rc)^2)))^2)/(2*mu0)"
# radial velocity pulse (zero on the axis, z-modulated): 0 = exact hold
implicit_mhd.velocity_x(x,y,z) = "u_pert * (x/rc) * exp(-(x/rc)^2) * cos(2*pi*z/Lz)"

warpx.B_ext_grid_init_style = parse_b_ext_grid_function
warpx.Bx_external_grid_function(x,y,z) = "0.0"
warpx.By_external_grid_function(x,y,z) = "0.0"
warpx.Bz_external_grid_function(x,y,z) = "B0*(1.0 - 2.0*exp(-(x/rc)^2))"

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 100
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Br Bt Bz implicit_mhd_mass_density \
                       implicit_mhd_ion_energy implicit_mhd_electron_energy \
                       implicit_mhd_momentum_r implicit_mhd_momentum_z
diag1.write_species = 0
