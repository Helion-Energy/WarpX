#################################
############ CONSTANTS ##########
#################################

my_constants.n0 = 1.0e20
my_constants.rho_bg = n0 * m_p
my_constants.rho_pulse = 3.0 * rho_bg
my_constants.Te = 0.5
my_constants.Pe = n0 * Te * q_e
my_constants.gamma = 5.0/3.0
my_constants.B0 = 1.0e-3
my_constants.u0 = 5.0e4
my_constants.Lr = 0.1
my_constants.Lz = 1.0
my_constants.nr = 16
my_constants.nz = 48
my_constants.z0 = 0.0
my_constants.w = 0.1
my_constants.sound_speed = sqrt(gamma*Pe/rho_bg)
my_constants.dt = 0.25 * (Lz/nz) / (u0 + sound_speed)

#################################
####### GENERAL PARAMETERS ######
#################################

# Neumann (zero-gradient) outflow ends in z: a passive density pulse
# advects at u0 through the z_hi boundary and must LEAVE. Uniform Bz and
# uniform axial flow keep the electromagnetic subsystem exactly static
# (E = -u x B = 0), so any field response or density residue measures
# boundary artifacts. With periodic z this same pulse would re-enter and
# still be inside the domain at the final time.
max_step = 240
amr.n_cell = nr nz
amr.max_grid_size = 24
amr.max_level = 0

geometry.dims = RZ
warpx.n_rz_azimuthal_modes = 1
geometry.prob_lo = 0.0 -0.5
geometry.prob_hi = Lr 0.5
boundary.field_lo = none none
boundary.field_hi = open none
boundary.particle_lo = none absorbing
boundary.particle_hi = reflecting absorbing

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 1.0

newton.verbose = true
newton.absolute_tolerance = 1.0e-11
newton.relative_tolerance = 1.0e-8
newton.max_iterations = 12
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-10
gmres.max_iterations = 300

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Te
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho_bg
implicit_mhd.reference_velocity = u0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = 0.0
implicit_mhd.mass_density_floor = 1.0e-4 * rho_bg
implicit_mhd.electron_pressure_floor = 1.0e-4 * Pe
implicit_mhd.fluid_flux = hllc
# Passive pulse: uniform electron pressure and uniform axial velocity, so
# the density contact advects without pressure coupling.
implicit_mhd.mass_density(x,y,z) = rho_bg + rho_pulse*exp(-((z-z0)/w)^2)
implicit_mhd.electron_pressure(x,y,z) = Pe
implicit_mhd.velocity_z(x,y,z) = u0


#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 240
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Br Bz Er jz implicit_mhd_mass_density \
                       implicit_mhd_electron_energy
diag1.write_species = 0

# Green's-function open boundary at r_hi (replaces the PEC wall of the
# base test): the fields see the free-space continuation of the interior
# plasma currents, and the fluid gets zero-gradient outflow radial ghosts.
# The ghost fill runs inside every JFNK residual evaluation.
boundary.open_bc_coarsening = 4
boundary.open_bc_image_sum_rtol = 1.0e-6
boundary.open_bc_max_images = 200

# The uniform Bz = B0 must enter through the SPLIT external vector
# potential (A_theta = 0.5*B0*r): a curl-free field written into the
# evolved B would be erased at the open face (see GreensFunctionOpenBC).
# The MLMG A-divergence cleaner rejects open BCs and is unnecessary here
# (an axisymmetric pure-theta A is exactly divergence-free).
hybrid_pic_model.add_external_fields = 1
external_vector_potential.fields = bore
external_vector_potential.bore.Ay_external_grid_function(x,y,z) = "0.5*B0*x"
external_vector_potential.do_diva_cleaning = 0
