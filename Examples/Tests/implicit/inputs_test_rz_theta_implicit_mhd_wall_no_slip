#################################
############ CONSTANTS ##########
#################################

# Reference-parity shaped-wall NO-SLIP FACE condition
# (implicit_mhd.wall_no_slip): the same sheared column the
# wall-viscosity-band test uses -- uniform density and pressure, a
# linear axial shear u_z = A r inside a cylinder wall (r_w = 0.30 m,
# cells i >= 15 masked at dr = 0.02), B = 0, J = 0, eta = 0, no
# conduction, no Joule -- but with the viscosity live EVERYWHERE (no
# wall_viscosity_mask), so the wall-adjacent row carries real viscous
# stress and the wall has something to hold against.
#
# A no-slip wall constrains the TANGENTIAL slip AT THE CONTOUR: the
# masked side of a stair interface face presents the ANTISYMMETRIC
# tangential image -u_t of the interior state, so the face-centered
# tangential velocity is exactly zero and the viscous difference
# quotient is the half-cell one-sided wall gradient (0 - u_t)/(dr/2).
# That is the reference code's unconditional contour Dirichlet (sten.f:1080-87,
# bb(n_1d+1:) = 0 for every bnd); their additional pinned "skin" ring
# is the cut-cell boundary layer of a NODE-COLLOCATED mesh whose
# layer-2 nodes are measured LIVE, not an inward band of cells.
#
# Contract under test (see analysis_mhd_wall_no_slip.py), against the
# wall_no_slip = 0 twin of the identical deck:
#  - ON: the wall-adjacent live row i = 14 keeps a LIVE momentum row
#    (it is not pinned to zero) but loses tangential momentum to the
#    wall shear relative to the free-slip twin;
#  - OFF: the same row slides essentially freely (the stair-face image
#    copies the tangential momentum verbatim -- a perfect-slip wall),
#    staying within a few percent of the initial rho A r;
#  - the drag is graded against the analytic wall shear
#    tau_w = rho nu u_t/(dr/2), which is what makes it a no-slip wall
#    rather than an arbitrary momentum sink;
#  - the far interior (i <= 8) is unchanged from the OFF twin to solver
#    precision: the wall layer must not reach past itself.
# The run is kept SHORT (nu t / dr^2 = 7.5e-3) so the shear layer stays
# inside the wall-adjacent rows.
my_constants.n0 = 1.0e20
my_constants.rho0 = n0 * m_p
my_constants.T0_ev = 4.0
my_constants.A = 1.0e3
my_constants.nu = 20.0
my_constants.gamma = 5.0/3.0
my_constants.B0 = 0.01
my_constants.Lr = 0.48
my_constants.Lz = 0.32
my_constants.nr = 24
my_constants.nz = 8
my_constants.dt = 5.0e-8

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 3
amr.n_cell = nr nz
amr.max_grid_size = 8
amr.max_level = 0

geometry.dims = RZ
warpx.n_rz_azimuthal_modes = 1
geometry.prob_lo = 0.0 -0.5*Lz
geometry.prob_hi = Lr 0.5*Lz
boundary.field_lo = none none
boundary.field_hi = pec none

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 1.0

newton.verbose = true
newton.absolute_tolerance = 1.0e-12
newton.relative_tolerance = 1.0e-10
newton.max_iterations = 12
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-10
gmres.max_iterations = 300

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = T0_ev
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.mass_density_floor = 1.0e-6 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-6 * n0 * T0_ev * q_e
implicit_mhd.ion_pressure_floor = 1.0e-6 * n0 * T0_ev * q_e
implicit_mhd.ion_closure = total_energy
implicit_mhd.fluid_flux = central
implicit_mhd.viscosity = nu
implicit_mhd.include_joule_heating = false
implicit_mhd.mass_density(x,y,z) = rho0
implicit_mhd.electron_pressure(x,y,z) = n0 * T0_ev * q_e
implicit_mhd.ion_pressure(x,y,z) = n0 * T0_ev * q_e
implicit_mhd.velocity_z(x,y,z) = A * x

# Cylinder conducting wall at r = 0.30 m (constant continuation covers
# the z ghosts). zero_flux is the INSULATING fluid contract: it makes
# the masked band a rigid conductor (a solid for the no-slip face to
# act against) and passes no heat, so the tangential wall shear is the
# only wall-fluid coupling under test.
implicit_mhd.wall_model = pec
implicit_mhd.wall_polyline_file = wall_cylinder_r30.csv
implicit_mhd.wall_thermal_bc = zero_flux
implicit_mhd.wall_no_slip = 1

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 3
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = implicit_mhd_mass_density \
                       implicit_mhd_ion_energy \
                       implicit_mhd_electron_energy \
                       implicit_mhd_momentum_r implicit_mhd_momentum_t \
                       implicit_mhd_momentum_z
diag1.write_species = 0
