#################################
############ CONSTANTS ##########
#################################

my_constants.n0 = 1.0e20
my_constants.rho0 = n0 * m_p
my_constants.Ti = 100.0
my_constants.P0 = n0 * Ti * q_e
my_constants.gamma = 5.0/3.0
# ELECTRON-pressure-dominated variant of the Sod deck: the electron
# pressure carries the jump and the ion pressure is an order of magnitude
# below it (p_e/p_i = 9, the FRC-halo regime of the field failure report).
# This exercises the electron-pressure coupling of the ion total-energy
# flux at full strength: an E_i flux whose pressure is inconsistent with
# the total-pressure HLLC wave structure locks the Newton line search here.
# Known limitation: hllc + total_energy still locks for p_e/p_i >~ 50 at
# this resolution (the Toro star energy exchanges O(p_total)-scale terms
# against a p_i-scale E_i at unresolved, near-stagnant jumps); rusanov
# handles arbitrary ratios.
my_constants.pi_over_pe = 1.0/9.0
my_constants.B0 = sqrt(mu0 * P0)
my_constants.nz = 128
my_constants.Lz = 1.6
# Periodic double Riemann problem: high state between the diaphragms.
my_constants.zl = 0.45
my_constants.zr = 1.15
my_constants.rho_ratio = 0.125
my_constants.p_ratio = 0.1
my_constants.v0 = sqrt(P0/rho0)
my_constants.t_end = 0.2 / v0
my_constants.dt = t_end / 200

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 200
amr.n_cell = nz
amr.max_grid_size = 32
amr.max_level = 0

geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = Lz
boundary.field_lo = periodic
boundary.field_hi = periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 1.0

newton.verbose = true
newton.absolute_tolerance = 1.0e-11
newton.relative_tolerance = 1.0e-9
newton.max_iterations = 20
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-9
gmres.max_iterations = 400

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Ti
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = pi_over_pe * P0
implicit_mhd.ion_closure = total_energy
implicit_mhd.ion_pressure_floor = 1.0e-6 * P0
implicit_mhd.mass_density_floor = 1.0e-6 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-6 * P0
implicit_mhd.fluid_flux = hllc
implicit_mhd.mass_density(x,y,z) = "rho0 * if((z>zl) and (z<zr), 1.0, rho_ratio)"
implicit_mhd.ion_pressure(x,y,z) = \
    "pi_over_pe * P0 * if((z>zl) and (z<zr), 1.0, p_ratio)"
implicit_mhd.electron_pressure(x,y,z) = "P0 * if((z>zl) and (z<zr), 1.0, p_ratio)"

# A uniform field keeps the electromagnetic subsystem quiescent.
warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.0 0.0 B0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 200
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Bz jz implicit_mhd_mass_density \
                       implicit_mhd_ion_energy implicit_mhd_electron_energy
diag1.write_species = 0
