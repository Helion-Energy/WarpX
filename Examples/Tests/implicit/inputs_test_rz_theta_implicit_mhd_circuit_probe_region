#################################
############ CONSTANTS ##########
#################################

# Circuit-probe REGION MASK and PHYSICAL-SHARE WEIGHT test (RZ, theta-
# implicit MHD, native circuit driver, Green's-function open r_hi
# boundary): a uniform static plasma in a uniform Bz carries ONE
# synthetic azimuthal current -- a compactly supported radial bump of
# Bz, J_theta = -(dBz/dr)/mu0, exactly zero outside the bump's cells --
# placed either OUTSIDE the wall polyline (rc = 0.15 m: nodes 10..14,
# r >= 0.125 m, exterior everywhere along z) or INSIDE it (rc = 0.02 m:
# nodes 0..3, r <= 0.0375 m, inside the interior region everywhere).
# Three measured coils (two in-domain analytic-loop probes, one
# out-of-domain ring-kernel reciprocity probe) are coupled to an
# undriven RL engine (V0 = 0; the coil scales stay 0 so the plasma
# response is the bump alone) and every batched linkage is pinned
# against the single-coil reference probes (circuit.probe_crosscheck,
# which under the mask/weight validates the two masked code paths
# against each other).
#
# The wall polyline (wall_probe_region_slope.csv) has a flat section
# r = 0.065 m, a sloped section 0.065 -> 0.085 m over z in [0, 0.1] and
# ends INSIDE the axial domain, so the rule's interpolation and both end
# clamps are exercised; the report's r_wall table is cross-checked
# bitwise against numpy.interp by the analysis.
#
# Arms (CLI overrides; see analysis_mhd_circuit_probe_region.py):
#   domain_outside: probe_region = domain + report, outside bump
#   wall_outside:   probe_region = wall_interior, outside bump
#   wall_inside:    probe_region = wall_interior, inside bump
#   weight_boost:   probe_weight = physical_share, outside bump in a
#                   deep-vacuum (density-keyed boosted eta) exterior
#   weight_plasma:  probe_weight = physical_share, inside bump in the
#                   plasma, vacuum exterior

my_constants.n0 = 1.0e20
my_constants.rho0 = n0 * m_p
my_constants.T0_ev = 10.0
my_constants.Pe0 = n0 * T0_ev * q_e
my_constants.Pi0 = n0 * T0_ev * q_e
my_constants.gam = 5.0/3.0
my_constants.B0 = 0.02
my_constants.B1 = 0.1 * B0
# bump center / half-width (outside: rc = 0.15, wb = 0.03; inside: rc =
# 0.02, wb = 0.015)
my_constants.rc = 0.15
my_constants.wb = 0.03
# density step (rho_vac_frac = 1: uniform plasma); the vacuum arms set
# 1e-4 with the boost on
my_constants.r_step = 0.1
my_constants.rho_vac_frac = 1.0
my_constants.eta0 = 1.0e-6
my_constants.nr = 16
my_constants.nz = 16
my_constants.rmax = 0.2
my_constants.zmax = 0.2
my_constants.dr = rmax / nr
my_constants.dz = 2.0 * zmax / nz
my_constants.cs2 = gam * (Pe0 + Pi0) / rho0
my_constants.va2 = B0 * B0 / (mu0 * rho0)
my_constants.dt = 0.5 * dz / sqrt(cs2 + va2)

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 3
amr.n_cell = nr nz
amr.max_grid_size = 8
amr.max_level = 0

geometry.dims = RZ
warpx.n_rz_azimuthal_modes = 1
geometry.prob_lo = 0.0 -zmax
geometry.prob_hi = rmax zmax
boundary.field_lo = none none
boundary.field_hi = open none
boundary.particle_lo = none absorbing
boundary.particle_hi = reflecting absorbing

#################################
############ NUMERICS ###########
#################################

# No warning abort threshold: the Green's open boundary raises a HIGH
# advisory whenever warpx.B_ext_grid_init_style writes into the evolved
# B (a curl-free loaded component would be erased at the open face).
# Here the loaded field is ONLY the compactly supported bump whose curl
# IS the synthetic current under test; the uniform B0 rides in the static
# split external register 'hold' as the advisory asks.
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 1.0

newton.verbose = true
newton.absolute_tolerance = 0.0
newton.relative_tolerance = 1.0e-10
newton.max_iterations = 20
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-11
gmres.max_iterations = 1000

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = T0_ev
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gam
hybrid_pic_model.n_floor = 1.0e-3 * n0
hybrid_pic_model.plasma_resistivity(rho,J,t) = eta0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

# Split external fields: one scale-driven (python_scale) entry per coil,
# zero painted potential (the reciprocity coil's unit field is filled
# from the ring kernel by the coil subsystem).
hybrid_pic_model.add_external_fields = 1
external_vector_potential.fields = hold loopA loopB ringC
external_vector_potential.do_diva_cleaning = 0
# the uniform Bz = B0 (a pure-theta axisymmetric A is exactly
# divergence-free, so the MLMG cleaner stays off)
external_vector_potential.hold.Ay_external_grid_function(x,y,z) = "0.5*B0*x"
external_vector_potential.hold.A_time_external_function(t) = "1.0"
external_vector_potential.loopA.Ay_external_grid_function(x,y,z) = "0.0"
external_vector_potential.loopA.python_scale = 1
external_vector_potential.loopA.initial_scale = 0.0
external_vector_potential.loopB.Ay_external_grid_function(x,y,z) = "0.0"
external_vector_potential.loopB.python_scale = 1
external_vector_potential.loopB.initial_scale = 0.0
external_vector_potential.ringC.Ay_external_grid_function(x,y,z) = "0.0"
external_vector_potential.ringC.python_scale = 1
external_vector_potential.ringC.initial_scale = 0.0

#################################
########### CIRCUIT #############
#################################

circuit.coils = loopA loopB ringC
circuit.loopA.r = 0.03
circuit.loopA.z = -0.1
circuit.loopA.fill_unit_field = 0
circuit.loopA.probe = loop
circuit.loopB.r = 0.05
circuit.loopB.z = 0.1
circuit.loopB.fill_unit_field = 0
circuit.loopB.probe = loop
circuit.ringC.r = 0.25
circuit.ringC.z = 0.0
circuit.ringC.fill_unit_field = 1
circuit.ringC.probe = reciprocity
circuit.probe_exclusion_radius = 2.0 * dr
# Undriven RL loops (the test-fixture plugin, built next to the
# executable): the coil scales stay at zero.
circuit.engine = external
circuit.plugin_library = ../librl_test_circuit.so
circuit.plugin_config = "R=2000.0,L=1.0,V0=0.0"
circuit.probe_crosscheck = 1
# The knobs under test (arms override on the command line).
circuit.probe_region = domain
circuit.probe_weight = none
circuit.probe_region_polyline_file = wall_probe_region_slope.csv
circuit.probe_region_report = diags/circuit_probe_region.txt

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.reference_ion_pressure = Pi0
implicit_mhd.mass_density_floor = 1.0e-5 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-6 * Pe0
implicit_mhd.ion_pressure_floor = 1.0e-6 * Pi0
implicit_mhd.gamma_e = gam
implicit_mhd.gamma_i = gam
implicit_mhd.ion_closure = total_energy
implicit_mhd.mass_density(x,y,z) = "if(x < r_step, rho0, rho_vac_frac * rho0)"
implicit_mhd.electron_pressure(x,y,z) = "if(x < r_step, Pe0, rho_vac_frac * Pe0)"
implicit_mhd.ion_pressure(x,y,z) = "if(x < r_step, Pi0, rho_vac_frac * Pi0)"
implicit_mhd.fluid_flux = central
implicit_mhd.viscosity = 3.0e3
implicit_mhd.external_field_iteration = 1
implicit_mhd.circuit_hook_scope = residual
implicit_mhd.circuit_driver = native
# Density-keyed vacuum boost of the field eta: off (uniform plasma, w ==
# 1 exactly); the vacuum arms turn it on.
implicit_mhd.vacuum_resistivity_diffusivity = 0.0

# Initial evolved (plasma-response) field: the compactly supported Bz
# bump alone (exactly zero outside |r - rc| < wb, so J_theta is exactly
# zero away from the bump's cells); the uniform B0 is the 'hold' external
# register above.
warpx.B_ext_grid_init_style = parse_b_ext_grid_function
warpx.Bx_external_grid_function(x,y,z) = 0.0
warpx.By_external_grid_function(x,y,z) = 0.0
warpx.Bz_external_grid_function(x,y,z) = "B1 * if(abs(x - rc) < wb, (1.0 - ((x - rc) / wb)**2)**2, 0.0)"

#################################
########### DIAGNOSTICS #########
#################################

# The coupler's own (masked / weighted) linkages per step.
warpx.reduced_diags_names = ccdiag
ccdiag.type = CircuitCoupling
ccdiag.intervals = 1
ccdiag.precision = 17

diagnostics.diags_names = diag1
diag1.intervals = 3
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Bz
diag1.write_species = 0
