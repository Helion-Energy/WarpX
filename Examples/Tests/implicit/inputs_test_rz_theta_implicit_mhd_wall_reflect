#################################
############ CONSTANTS ##########
#################################

# Shaped-wall FLUID PERMEABILITY test (implicit_mhd.wall_fluid_bc; RZ,
# production flux central + limited Rusanov, live ions, total_energy):
# a uniform plasma is driven INTO a NOTCHED BOTTLE wall -- r_w = 0.30 m
# for 0.08 < |z| < 0.30 m, 0.22 m inside the notch, and 0.02 m (one
# live axis cell) in the end plugs |z| > 0.30 m -- by a radial expansion
# u_r = Ar r (r-normal stair faces at two radii) and by two axial pulses
# in the outer ring 0.22 < r < 0.30 m aimed at the two notch ledges
# (z-normal stair faces of BOTH orientations, plus the plug faces). The
# plugs close the domain with the wall itself: no z-end fluid boundary
# of this solver is mass-tight (neumann/outflow/wall_temperature all
# copy the end momentum; a plain Neumann box measured a rarefaction-fed
# inflow of 1.4 % of the mass through its ends), so with the wall and
# the r = 0 axis the only non-interface exit is the two axis cells' end
# faces, 0.2 % of the wall area and far from every flow.
#
# reflect (this file): the masked side presents the ODD-normal-momentum
# image, so no mass crosses the contour -- the total fluid mass is
# conserved to solver tolerance, the wall ledger books an exactly zero
# crossing mass, and the arriving plasma piles up in the last live cells
# (density and pressure rise: the impermeable wall of the reference
# code, stair corners included).
#
# absorb (the CLI twin, implicit_mhd.wall_fluid_bc=absorb = the default,
# the dielectric scraper): the same drive removes a measurable fraction
# of the mass through the interface and the ledger books it (its
# existing closure contract).
#
# The stair corners (live cells with masked neighbours in BOTH
# directions -- the notch ledges' nooks) are reported explicitly:
# max T_i, T_e, E_i and n over the corner-classified cells, the
# expected hot pockets of a rigid image (reported, not gated).

my_constants.n0 = 1.0e20
my_constants.rho0 = n0 * m_p
my_constants.T0_ev = 100.0
my_constants.Twall_ev = 2.0
my_constants.chi_i = 2.0e3
my_constants.nu = 50.0
my_constants.Ar = 1.0e5
my_constants.Az = 1.5e5
my_constants.zp = 0.15
my_constants.wz = 0.03
my_constants.rring = 0.20
my_constants.wr = 0.015
my_constants.gamma = 5.0/3.0
my_constants.B0 = 0.01
my_constants.Lr = 0.48
my_constants.Lz = 0.80
my_constants.nr = 24
my_constants.nz = 40
my_constants.dt = 5.0e-8

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 16
amr.n_cell = nr nz
amr.max_grid_size = 20
amr.max_level = 0

geometry.dims = RZ
warpx.n_rz_azimuthal_modes = 1
geometry.prob_lo = 0.0 -0.5*Lz
geometry.prob_hi = Lr 0.5*Lz
boundary.field_lo = none none
boundary.field_hi = pec none

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 1.0

newton.verbose = true
newton.absolute_tolerance = 1.0e-12
newton.relative_tolerance = 1.0e-9
newton.max_iterations = 20
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-10
gmres.max_iterations = 300

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = T0_ev
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.mass_density_floor = 1.0e-6 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-6 * n0 * T0_ev * q_e
implicit_mhd.ion_pressure_floor = 1.0e-6 * n0 * T0_ev * q_e
implicit_mhd.ion_closure = total_energy
implicit_mhd.fluid_flux = central
implicit_mhd.fluid_reconstruction = median
implicit_mhd.central_dissipation = 1.0
implicit_mhd.viscosity = nu
implicit_mhd.thermal_diffusivity_ion = chi_i
implicit_mhd.include_joule_heating = false
implicit_mhd.mass_density(x,y,z) = rho0
implicit_mhd.electron_pressure(x,y,z) = n0 * T0_ev * q_e
implicit_mhd.ion_pressure(x,y,z) = n0 * T0_ev * q_e
implicit_mhd.velocity_x(x,y,z) = Ar * x
implicit_mhd.velocity_y(x,y,z) = 0.0
# two axial pulses in the outer ring, each aimed at the nearer notch
# ledge (toward -z above the notch, toward +z below it); zero at the
# z ends
implicit_mhd.velocity_z(x,y,z) = "Az * 0.5*(1+tanh((x-rring)/wr)) * (exp(-((z+zp)/wz)^2) - exp(-((z-zp)/wz)^2))"

# Notched bottle wall (constant continuation covers the z ghosts):
# r-normal stair faces at 0.30, 0.22 and 0.02 m, z-normal ledges at
# z = -0.08 (masked side at +z) and z = +0.08 (masked side at -z), and
# the plug faces at z = -0.30 (masked side at -z) and +0.30 (at +z).
implicit_mhd.wall_model = pec
implicit_mhd.wall_polyline_file = wall_bottle_notch_r30_r22.csv
implicit_mhd.wall_thermal_bc = outflow_limited
implicit_mhd.wall_temperature = Twall_ev
implicit_mhd.wall_no_slip = 1
implicit_mhd.wall_fluid_bc = reflect
implicit_mhd.wall_ledger_file = diags/wall_ledger.txt

warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.0 0.0 B0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 1
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = implicit_mhd_mass_density \
                       implicit_mhd_ion_energy \
                       implicit_mhd_electron_energy \
                       implicit_mhd_momentum_r implicit_mhd_momentum_t \
                       implicit_mhd_momentum_z
diag1.write_species = 0
