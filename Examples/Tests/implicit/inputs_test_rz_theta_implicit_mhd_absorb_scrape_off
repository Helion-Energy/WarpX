#################################
############ CONSTANTS ##########
#################################

my_constants.n0 = 1.0e20
my_constants.rho0 = n0 * m_p
my_constants.Te = 10.0
my_constants.Ti = 10.0
my_constants.Pe = n0 * Te * q_e
my_constants.Pi = n0 * Ti * q_e
my_constants.gamma = 5.0/3.0
# Magnetically dominated wall (beta ~ 0.16): the retired forced-v_A
# absorber's failure scaled with the wall-band Alfven speed at PEDESTAL
# density, v_A(rho_ped) = 31.6 v_A0 >> c_s -- the FRC scrape-off-arrival
# regime (its corner alphas at alpha dt/dr >> 1).
my_constants.B0 = 0.07
my_constants.u0 = 3.0e4
my_constants.Lr = 0.1
my_constants.Lz = 0.4
my_constants.nr = 16
my_constants.nz = 32
# Wall band loaded at 1.2x the halo pedestal (1e-3 of the peak): the
# mass drain gates are PARTIALLY open there -- exactly the scrape-off
# arrival state (the fully pinned band is dynamically inert; the fully
# open bulk is not the failure window).
my_constants.band = 1.2e-3
my_constants.redge = 0.045
my_constants.rwidth = 0.02
my_constants.sound_speed = sqrt(gamma*(Pe+Pi)/rho0)
my_constants.alfven_speed = B0 / sqrt(mu0*rho0)
my_constants.dt = 0.25 * (Lr/nr) / (sound_speed + alfven_speed + u0)

#################################
####### GENERAL PARAMETERS ######
#################################

# Scrape-off arrival onto the absorbing wall (r_open_fluid = absorb,
# hlld, magnetically dominated): a dense column drives its edge into a
# near-pedestal wall band threaded by a strong external field with a
# nonzero B_r through the open wall face -- the miniature of the FRC
# mirror benchmark's deterministic scrape-off-arrival blowup. An
# absorber whose ghost state carries VACUUM-density signal speeds (the
# retired forced-v_A pedestal image) is Newton-intractable here the
# moment the drain gates open: measured on this deck, every solve
# freezes from step 1 (10-consecutive frozen-step guard abort, absorbed
# ENERGY counter running NEGATIVE -- the wall pumping the domain). The
# impedance-matched one-way absorber must run the full window with
# bounded fields, a monotone absorbed-mass ledger that matches the
# domain mass loss (periodic z: the wall is the only exit), and no
# wall-band storage. The solver runs the production policy
# (require_convergence = false + the frozen-step guard): the arrival
# is genuinely hard, and accepting occasional non-converged solves
# while asserting zero FROZEN solves is exactly how the production
# benchmark distinguishes a healthy wall from this failure mode.
max_step = 120
amr.n_cell = nr nz
amr.max_grid_size = 24
amr.max_level = 0

geometry.dims = RZ
warpx.n_rz_azimuthal_modes = 1
geometry.prob_lo = 0.0 -0.2
geometry.prob_hi = Lr 0.2
boundary.field_lo = none periodic
boundary.field_hi = open periodic
boundary.particle_lo = none periodic
boundary.particle_hi = reflecting periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 1.0

newton.verbose = true
newton.absolute_tolerance = 1.0e-11
newton.relative_tolerance = 1.0e-4
newton.max_iterations = 25
newton.require_convergence = false
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-10
gmres.max_iterations = 500

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Te
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_velocity = u0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = Pi
implicit_mhd.ion_closure = total_energy
implicit_mhd.mass_density_floor = 1.0e-5 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-5 * Pe
implicit_mhd.ion_pressure_floor = 1.0e-5 * Pi
implicit_mhd.fluid_flux = hlld
implicit_mhd.allow_hlld = true   # kernel regression coverage; central is production
implicit_mhd.r_open_fluid = absorb
implicit_mhd.halo_pedestal_fraction = 1.0e-3
implicit_mhd.absorb_ledger_interval = 10
implicit_mhd.absorb_ledger_file = diags/absorb_ledger.txt
# Dense column with a tanh edge at r = redge; wall band at 1.2x the
# pedestal. Pressures scale with the density (uniform temperatures).
implicit_mhd.mass_density(x,y,z) = rho0*(band + (1-band)*0.5*(1-tanh((x-redge)/rwidth)))
implicit_mhd.electron_pressure(x,y,z) = Pe*(band + (1-band)*0.5*(1-tanh((x-redge)/rwidth)))
implicit_mhd.ion_pressure(x,y,z) = Pi*(band + (1-band)*0.5*(1-tanh((x-redge)/rwidth)))
# Radial drive pressing the column edge into the wall band (the band
# itself starts static, riding just above the pedestal).
implicit_mhd.velocity_x(x,y,z) = u0 * (x/redge) * 0.5*(1-tanh((x-redge)/rwidth))
implicit_mhd.velocity_y(x,y,z) = 0.0
implicit_mhd.velocity_z(x,y,z) = 0.0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 120
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Br Bt Bz implicit_mhd_mass_density \
                       implicit_mhd_ion_energy implicit_mhd_electron_energy
diag1.write_species = 0

# Green's-function open boundary at r_hi with a strong external field
# threading B_r through the wall face (the corner-EMF channel needs a
# realistic |B| at the wall band).
boundary.open_bc_coarsening = 4
boundary.open_bc_image_sum_rtol = 1.0e-6
boundary.open_bc_max_images = 200

hybrid_pic_model.add_external_fields = 1
external_vector_potential.fields = bore
external_vector_potential.bore.Ay_external_grid_function(x,y,z) = "0.5*B0*x*(1 + 0.9*cos(2*pi*z/Lz))"
external_vector_potential.do_diva_cleaning = 0
