#################################
############ CONSTANTS ##########
#################################

# WALL HEAT-FLUX CAP (implicit_mhd.wall_heat_flux_cap) of the shaped-wall
# conductive exchange: a hot static uniform TWO-TEMPERATURE column
# (Te0 = 100 eV, Ti0 = 40 eV -- distinct on purpose: the sonic cap's
# sound speed c_s^2 = gamma (kB Te + kB Ti)/m_i mixes both, so a cap
# built from one species' temperature alone cannot reproduce the gate)
# inside a STRAIGHT cylinder wall at r_w = 0.065 m (the mask's first
# conductor cell centre is 0.06875, so the interface is the grid face at
# r = 0.0625), against a wall_thermal_bc = dirichlet bath at T_wall =
# 2 eV. Conduction is CONSTANT and ISOTROPIC in both channels, so the
# uncapped half-cell wall exchange is exactly
#
#     q_unl = chi rho (e - e_wall) 2/dr   [W/m^2]
#
# per channel, with no clamp bookkeeping, and every cap this deck's
# ctests select is the smooth harmonic form q_unl/(1 + q_unl/q_cap):
#
#   sonic          (CLI wall_heat_flux_cap=sonic): q_cap = f n kB T_s c_s,
#                  f = 2.5 by default (1.25 in the factor twin);
#   free_streaming (dirichlet_limited with the knob UNSET, and the knob's
#                  free_streaming override on the hard pin, which must be
#                  bit-identical to it): q_cap = n kB T_s v_th,s.
#
# chi is chosen so that the uncapped drain sits within ~20 percent of
# the SONIC cap at the initial state (q_unl/q_cap = 1.1 ion, 1.2
# electron), where the harmonic cap lands near q_cap/2 -- two-fold away
# from both the uncapped value and a hard min(q_unl, q_cap), so the FORM
# of the cap is gated, not only its magnitude. The face state the cap
# reads is the end-of-step (theta = 1) reservoir average, so the analysis
# solves the nonlinear backward-Euler first step of the capped column
# (the two channels couple through c_s) and gates the measured ring and
# column drains per channel at 1 percent.
my_constants.n0 = 1.0e18
my_constants.rho0 = n0 * m_p
my_constants.Te0_ev = 100.0
my_constants.Ti0_ev = 40.0
my_constants.Twall_ev = 2.0
my_constants.Pe0 = n0 * Te0_ev * q_e
my_constants.Pi0 = n0 * Ti0_ev * q_e
my_constants.gamma = 5.0/3.0
my_constants.B0 = 5.0e-4
my_constants.Lr = 0.1
my_constants.Lz = 0.1
my_constants.nr = 8
my_constants.nz = 8
# constant isotropic operator diffusivity [m^2/s], both channels
my_constants.chi = 700.0
# chi dt/dr^2 = 0.018 (dr = Lr/nr = 0.0125 m): the uncapped half-cell wall
# rate is 2 * 0.018 * (r_face/r_centre) = 0.04 per step, the capped one
# about half of it, so the wall ring drops ~2 percent of (e0 - e_wall) on
# the first step -- resolved to 1e-12 by the Newton tolerances. The
# acoustic response of the cooling ring (sound CFL 0.035 per step) does
# p dV work on the interior that the conduction model does not carry;
# its share of the first-step drain scales with dt and sits at ~0.5
# percent of the smallest (free-streaming ion) signal at this step.
my_constants.dt = 4.0e-9

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 4
amr.n_cell = nr nz
amr.max_grid_size = 4
amr.max_level = 0

geometry.dims = RZ
warpx.n_rz_azimuthal_modes = 1
geometry.prob_lo = 0.0 -0.5*Lz
geometry.prob_hi = Lr 0.5*Lz
boundary.field_lo = none none
boundary.field_hi = pec none

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 1.0

newton.verbose = true
newton.absolute_tolerance = 1.0e-12
newton.relative_tolerance = 1.0e-10
newton.max_iterations = 20
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-11
gmres.max_iterations = 300

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Te0_ev
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = Pi0
implicit_mhd.mass_density_floor = 1.0e-4 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-6 * Pe0
implicit_mhd.ion_pressure_floor = 1.0e-6 * Pi0
implicit_mhd.fluid_flux = central
implicit_mhd.viscosity = 0.5
implicit_mhd.ion_closure = total_energy
implicit_mhd.thermal_diffusivity_ion = chi
implicit_mhd.thermal_diffusivity_electron = chi
implicit_mhd.mass_density(x,y,z) = rho0
implicit_mhd.electron_pressure(x,y,z) = Pe0
implicit_mhd.ion_pressure(x,y,z) = Pi0

# Straight cylinder wall with the HARD Dirichlet thermal pin; the cap
# knob stays UNSET here and each ctest selects it on the CLI
# (wall_heat_flux_cap = sonic | free_streaming, or wall_thermal_bc =
# dirichlet_limited for the legacy capped pin).
implicit_mhd.wall_model = pec
implicit_mhd.wall_polyline_file = wall_flat_r065.csv
implicit_mhd.wall_thermal_bc = dirichlet
implicit_mhd.wall_temperature = Twall_ev
implicit_mhd.wall_ledger_file = diags/wall_ledger.txt

warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.0 0.0 B0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 1
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Bz implicit_mhd_mass_density \
                       implicit_mhd_electron_energy implicit_mhd_ion_energy \
                       implicit_mhd_momentum_r implicit_mhd_momentum_t \
                       implicit_mhd_momentum_z
diag1.write_species = 0
