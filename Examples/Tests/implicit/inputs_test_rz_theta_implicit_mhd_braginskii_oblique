#################################
############ CONSTANTS ##########
#################################

# Braginskii electron conduction with a LIVE cross term: the spreading
# deck's strongly magnetized plasma (Omega_e tau_e ~ 9.6e3 at Te0,
# chi_perp/chi_par ~ 1.6e-8) with the hot spot moved off axis and the
# field TILTED by ~25 degrees at the spot, so bhat_r bhat_z != 0 and the
# tangential corner stencil of the tensor flux
#   q_n = -rho [chi_perp de/dn + (chi_par - chi_perp) bhat_n (bhat . grad e)]
# carries an O(1) fraction of the parallel flux through both face
# families. This is the deck the cross-term limiter options
# (implicit_mhd.braginskii_tangential_limiter) are measured on:
# monotonicity (the exact anisotropic diffusion obeys the maximum
# principle, so no cell may leave [e_min, e_max] of the initial state)
# and Newton/GMRES work per step at a face conduction number
# D = chi_par dt / h^2 ~ 30 in the background (over a hundred at the
# 2x hotter spot peak, chi ~ T^5/2) -- and ~70 / several hundred at the
# production-stiffness override dt = 5e-9 used by the limiter study.
#
# The tilted field is the solenoidal external vector potential
#   A_theta = B0 r/2 - (alpha Lz/(2 pi)) sin(2 pi z/Lz) (r - r^3/Lr^2)
# i.e. B_r = alpha r (1 - r^2/Lr^2) cos(2 pi z/Lz),
#      B_z = B0 - (alpha Lz/(2 pi)) (2 - 4 r^2/Lr^2) sin(2 pi z/Lz)
# (periodic in z, div B = 0 exactly, B_r = 0 on the axis AND on the outer
# radial boundary so no cross-term flux threads the r_hi domain face --
# a tilted field there puts a tangential-gradient flux through the
# boundary face and breaks the energy ledger -- and
# tan(tilt) = 0.66 alpha r0/B0 at the spot centre z = 0). Ions are frozen
# (barotropic closure, evolve_ion_fluid = false) and the electromagnetic
# subsystem is quiescent (u = 0, eta = 0, Hall off), so the run isolates
# the tensor conduction channel. The production block preconditioner with
# its conduction Helmholtz block is on: without it GMRES saturates its
# iteration cap at this conduction number and the Newton comparison
# between limiters is confounded by the linear solve.
my_constants.n0 = 1.0e18
my_constants.rho0 = n0 * m_p
my_constants.Te0 = 10.0
my_constants.Pe0 = n0 * Te0 * q_e
my_constants.gamma = 5.0/3.0
my_constants.B0 = 0.05
my_constants.nr = 24
my_constants.nz = 48
my_constants.Lr = 0.6
my_constants.Lz = 1.0
# spot centre radius and the field tilt there:
# 0.66 alpha r0 / B0 = tan(25 deg) with 1 - r0^2/Lr^2 = 0.66
my_constants.r0 = 0.35
my_constants.alpha = 0.4663 * B0 / (r0 * (1.0 - r0*r0/(Lr*Lr)))
# Gaussian spot: half-width w, 2x temperature contrast (a genuinely
# nonlinear chi(T) and a steep tangential front for the limiter)
my_constants.w = 0.1
my_constants.dTe = 1.0
# D_z = chi_par(Te0) dt / dz^2 ~ 28, D_r ~ 19 (chi_par_e(Te0, n0) ~ 6.05e6):
# the CTest value, at which minmod and smart_upwind converge to the
# solver tolerances every step. The production-stiffness table of the
# limiter study (D ~ 70) is the command-line override dt = 5e-9.
my_constants.dt = 2.0e-9

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 10
amr.n_cell = nr nz
amr.max_grid_size = 24
amr.max_level = 0

geometry.dims = RZ
geometry.prob_lo = 0.0 -0.5*Lz
geometry.prob_hi = Lr 0.5*Lz
boundary.field_lo = none periodic
boundary.field_hi = pec periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5

newton.verbose = true
newton.absolute_tolerance = 1.0e-12
newton.relative_tolerance = 1.0e-10
newton.max_iterations = 20
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-10
gmres.max_iterations = 300
gmres.restart_length = 100

# The production block preconditioner with its conduction Helmholtz block
# (the same settings as the RZ conduction_pc test).
jacobian.pc_type = pc_mhd_block
pc_mhd_block.field_iterations = 2
pc_mhd_block.fluid_iterations = 2
pc_mhd_block.conduction_block = 1
pc_mhd_block.conduction_threshold = 1.0
pc_mhd_block.agglomeration = true
pc_mhd_block.consolidation = true
pc_mhd_block.max_coarsening_level = 30

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Te0
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

# The tilted poloidal field enters as an external vector potential (the
# grid external-field parser supports only Bz in RZ).
hybrid_pic_model.add_external_fields = 1
external_vector_potential.fields = tilt
external_vector_potential.tilt.Ay_external_grid_function(x,y,z) = \
    "0.5*B0*x - alpha*Lz/(2*pi)*sin(2*pi*z/Lz)*(x - x*x*x/(Lr*Lr))"
external_vector_potential.do_diva_cleaning = 0

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = 0.0
implicit_mhd.mass_density_floor = 1.0e-6 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-6 * Pe0
implicit_mhd.evolve_ion_fluid = false
implicit_mhd.fluid_flux = central
# required by the central flux; inert here (u = 0, frozen ions)
implicit_mhd.viscosity = 0.5
implicit_mhd.thermal_conduction_model = braginskii
implicit_mhd.conduction_coulomb_log = 10.0
implicit_mhd.mass_density(x,y,z) = rho0
implicit_mhd.electron_pressure(x,y,z) = \
    "Pe0*(1.0 + dTe*exp(-((x-r0)*(x-r0) + z*z)/(w*w)))"
# implicit_mhd.braginskii_tangential_limiter is set per arm from the
# command line (none | minmod | smart | smart_upwind).

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 10
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Br Bz implicit_mhd_mass_density \
                       implicit_mhd_electron_energy
diag1.write_species = 0
