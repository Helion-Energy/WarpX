#################################
############ CONSTANTS ##########
#################################

# Three-band static column calibrating the COLD pedestal image
# (implicit_mhd.halo_pedestal_temperature_e / _i): a dense bulk in the
# central half and a sub-pedestal halo (two decades BELOW the pedestal)
# on either side, loaded at DIFFERENT pressures on the two sides --
#   * z <  0.25: the cold halo band, 0.1 x the bulk pressure (below the
#     cold image: every raise form lifts it onto the image);
#   * z >= 0.75: the hot halo band, 3 x the bulk pressure (ABOVE the
#     cold image: the "reset" raise cools it onto the image, the "floor"
#     raise leaves it hot, the peak image f x max(U) leaves it hot and
#     lifts the cold band only to 0.3 x the bulk pressure);
# and the cold image is chosen in PRESSURE BALANCE with the bulk,
#     n_ped kB T_ped = n0 kB T_bulk   (T_ped = T_bulk / f),
# so that after the first step's raise (reset form) the whole column is
# a uniform-pressure static contact with zero velocity and field: the
# residual is identically zero and the raised state rides unchanged --
# an exact-equality calibration of the image arithmetic for both
# species, of the dual-energy sync (E_i = U_i on the raised cells) and of
# the refresh ledger (signed: the hot band gives back more than the cold
# band receives).
my_constants.n0 = 1.0e18
my_constants.rho0 = n0 * m_p
my_constants.pedestal_fraction = 0.1
my_constants.rho_halo = 1.0e-3 * rho0
my_constants.Te_bulk = 1.0
my_constants.Ti_bulk = 2.0
my_constants.Pe_bulk = n0 * Te_bulk * q_e
my_constants.Pi_bulk = n0 * Ti_bulk * q_e
# Cold image temperatures [eV] in pressure balance with the bulk.
my_constants.T_ped_e = Te_bulk / pedestal_fraction
my_constants.T_ped_i = Ti_bulk / pedestal_fraction
my_constants.B0 = 1.0e-4
my_constants.nz = 64
my_constants.Lz = 1.0
my_constants.dt = 1.0e-9

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 5
amr.n_cell = nz
amr.max_grid_size = nz
amr.max_level = 0

geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = Lz
boundary.field_lo = periodic
boundary.field_hi = periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5

newton.verbose = true
newton.absolute_tolerance = 1.0e-12
newton.relative_tolerance = 1.0e-11
newton.max_iterations = 8
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-11
gmres.max_iterations = 200

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Te_bulk
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.n_floor = 1.0e8
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

# Reference density HALF the peak: the dynamic pedestal keys to the
# instantaneous peak, rho_ped = f max(rho_peak, rho_ref) = 0.1 rho0.
implicit_mhd.reference_mass_density = 0.5 * rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = 5.0/3.0
implicit_mhd.gamma_i = 5.0/3.0
implicit_mhd.reference_ion_pressure = Pi_bulk
implicit_mhd.mass_density(x,y,z) = if((z>0.25)*(z<0.75), rho0, rho_halo)
implicit_mhd.electron_pressure(x,y,z) = if((z>0.25)*(z<0.75), Pe_bulk, if(z<0.25, 0.1*Pe_bulk, 3.0*Pe_bulk))
implicit_mhd.ion_pressure(x,y,z) = if((z>0.25)*(z<0.75), Pi_bulk, if(z<0.25, 0.1*Pi_bulk, 3.0*Pi_bulk))
implicit_mhd.evolve_ion_fluid = true
implicit_mhd.fluid_flux = central
# The central flux requires the explicit viscous stabilization (the
# production pairing); zero velocity keeps it inert.
implicit_mhd.viscosity = 1.0
implicit_mhd.ion_closure = dual_energy
# Positivity floors far below every loaded and imaged state (the energy
# closures require them); the cold image at the pedestal base is 0.08 Pa.
implicit_mhd.electron_pressure_floor = 1.0e-8
implicit_mhd.ion_pressure_floor = 1.0e-8
implicit_mhd.include_joule_heating = true
implicit_mhd.halo_pedestal_fraction = pedestal_fraction
# The cold pedestal image under test (both species), reset raise
# (default), and the refresh ledger.
implicit_mhd.halo_pedestal_temperature_e = T_ped_e
implicit_mhd.halo_pedestal_temperature_i = T_ped_i
implicit_mhd.halo_pedestal_ledger_file = halo_pedestal_ledger.txt

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 1
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Ex Ey Ez Bx By Bz \
                       implicit_mhd_mass_density implicit_mhd_momentum_density \
                       implicit_mhd_electron_energy implicit_mhd_ion_energy \
                       implicit_mhd_ion_internal_energy
diag1.write_species = 0
