#################################
############ CONSTANTS ##########
#################################

# Stiff density-keyed vacuum-resistive diffusion in RZ (hlld path, frozen
# ions): a plasma column with a low-density halo keys the uncapped vacuum
# eta boost (eta contrast ~55 across the radius), the z modulation bends
# the axisymmetric Bz(r) decay into Br through d_z E_theta, and the time
# step is chosen so the grid-scale resistive diffusion number is
# z = (eta_max/mu0) dt / dr^2 = 150. Unpreconditioned GMRES burns O(1500)
# cumulative iterations on the two steps; the preconditioned twin
# (inputs_test_rz_theta_implicit_mhd_vacuum_resistive_pc) must reproduce
# the fields to solver roundoff at a small fraction of that.
my_constants.n0 = 1.0e18
my_constants.rho0 = n0 * m_p
my_constants.Te = 1.0
my_constants.Pe = n0 * Te * q_e
my_constants.B0 = 1.0e-3
my_constants.dB = 1.0e-4
my_constants.nr = 16
my_constants.nz = 32
my_constants.Lr = 0.1
my_constants.Lz = 0.4
my_constants.kz = 2*pi/Lz
my_constants.r0 = 0.05
my_constants.halo = 0.25
my_constants.zmod = 0.3
my_constants.n_floor_ohm = 4.0e18
my_constants.D_vac = 1.0e5
# Stiffest cell: the halo density minimum n_min = n0*halo*(1-zmod).
my_constants.eta_max = mu0 * D_vac * (n_floor_ohm/(n0*halo*(1-zmod)))^2
my_constants.dr = Lr/nr
# Grid-scale resistive diffusion number z = (eta_max/mu0) dt / dr^2.
my_constants.stiffness = 150.0
my_constants.dt = stiffness * dr^2 * mu0 / eta_max

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 2
amr.n_cell = nr nz
amr.max_grid_size = 16
amr.max_level = 0

geometry.dims = RZ
warpx.n_rz_azimuthal_modes = 1
geometry.prob_lo = 0.0 0.0
geometry.prob_hi = Lr Lz
boundary.field_lo = none periodic
boundary.field_hi = pec periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5

newton.verbose = true
newton.absolute_tolerance = 1.0e-14
newton.relative_tolerance = 1.0e-11
newton.max_iterations = 12
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-11
gmres.max_iterations = 1000

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Te
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.n_floor = n_floor_ohm
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = 5.0/3.0
implicit_mhd.gamma_i = 5.0/3.0
implicit_mhd.reference_ion_pressure = 0.0
# Plasma column with a low-density halo (well below the Ohm guard, so the
# density-keyed vacuum eta varies strongly in r) and a z modulation (so the
# eta gradient excites Br through d_z E_theta).
implicit_mhd.mass_density(x,y,z) = rho0*(halo + (1-halo)*exp(-(x/r0)^4))*(1 + zmod*cos(kz*z))
implicit_mhd.electron_pressure(x,y,z) = Pe
implicit_mhd.evolve_ion_fluid = false
implicit_mhd.fluid_flux = hlld
implicit_mhd.allow_hlld = true   # kernel regression coverage; central is production
implicit_mhd.include_joule_heating = true
implicit_mhd.vacuum_resistivity_diffusivity = D_vac
implicit_mhd.resistive_theta = 1.0

# Radial Bz profile: J_theta = -dBz/dr diffuses resistively (through the
# corner E_theta), and the z-varying eta bends the decay into Br.
warpx.B_ext_grid_init_style = parse_b_ext_grid_function
warpx.Bx_external_grid_function(x,y,z) = 0.0
warpx.By_external_grid_function(x,y,z) = 0.0
warpx.Bz_external_grid_function(x,y,z) = B0 + dB*cos(0.5*pi*x/Lr)

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 2
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Br Bt Bz jr jt jz implicit_mhd_mass_density \
                       implicit_mhd_momentum_density implicit_mhd_electron_energy
diag1.write_species = 0
