#################################
############ CONSTANTS ##########
#################################

my_constants.n0 = 1.0e18
my_constants.rho0 = n0 * m_p
# Loaded halo: three decades BELOW the pedestal (and far above the
# 1e-12 positivity floor), so the per-step pedestal raise is exercised.
my_constants.rho_halo = 1.0e-6 * rho0
my_constants.pedestal_fraction = 1.0e-3
my_constants.Te = 0.01
my_constants.Pe = n0 * Te * q_e
my_constants.B0 = 1.0e-4
my_constants.nz = 64
my_constants.Lz = 1.0
# Sound crossing of a cell at the PEDESTAL density (the fastest signal
# in the raised state) is ~4e-10 s; a static contact does not care, but
# keep the implied CFL modest anyway.
my_constants.dt = 1.0e-9

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 5
amr.n_cell = nz
amr.max_grid_size = nz
amr.max_level = 0

geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = Lz
boundary.field_lo = periodic
boundary.field_hi = periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5

newton.verbose = true
newton.absolute_tolerance = 1.0e-12
newton.relative_tolerance = 1.0e-11
newton.max_iterations = 8
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-11
gmres.max_iterations = 200

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Te
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.n_floor = 1.0e8
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

# The reference density is HALF the loaded peak: the dynamic pedestal
# rho_ped = f * max(rho_peak, rho_ref) must key to the instantaneous
# peak (1e-3 rho0), not the reference (which would give 5e-4 rho0) --
# the analysis discriminates the two.
implicit_mhd.reference_mass_density = 0.5 * rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = 5.0/3.0
implicit_mhd.gamma_i = 5.0/3.0
implicit_mhd.reference_ion_pressure = 0.0
implicit_mhd.mass_density(x,y,z) = if((z>0.25)*(z<0.75), rho0, rho_halo)
implicit_mhd.electron_pressure(x,y,z) = Pe
implicit_mhd.evolve_ion_fluid = true
implicit_mhd.fluid_flux = hlld
implicit_mhd.include_joule_heating = true
implicit_mhd.halo_pedestal_fraction = pedestal_fraction

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 5
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Ex Ey Ez Bx By Bz \
                       implicit_mhd_mass_density implicit_mhd_momentum_density \
                       implicit_mhd_electron_energy
diag1.write_species = 0
