# base input parameters
FILE = inputs_test_1d_theta_implicit_mhd_hyper_resistive

# Preconditioned banded twin of the calibrated hyper-resistive decay: the
# pc_mhd_block resistive block carries the frozen eta_H chain (grid-scale
# hyper number ~540 here, so the block engages on eta_H alone; eta = 0),
# inverted by the block-banded LU at bandwidth 2. The calibrated decay
# assertions are the baseline's, unchanged; the analysis additionally
# requires a strict cumulative-GMRES reduction against the baseline (a
# wrong eta_H operator could not deliver it), and every active update
# roundoff-validates the assembled eta_H rows against the matrix-free
# operator (in-run abort on mismatch).
jacobian.pc_type = pc_mhd_block
pc_mhd_block.resistive_solver = banded
pc_mhd_block.resistive_validate_assembly = 1
