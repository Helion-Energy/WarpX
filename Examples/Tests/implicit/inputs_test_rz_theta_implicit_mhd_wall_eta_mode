#################################
############ CONSTANTS ##########
#################################

# Wall-band resistivity TREATMENT test (implicit_mhd.wall_band_eta_mode =
# override | neumann | transparent; RZ, central recast flux, frozen ions,
# dielectric standoff on the stepped polyline, uniform external Bz drive
# ramp): the wall_band_eta_override deck at 24 x 12 with a dense uniform
# plasma up to the contour (the production situation: gas on the wall,
# so the density-keyed vacuum boost -- off here -- never lifts the eta
# at the wall) and the override 500x the plasma eta. The shielding
# response of the ramp is a screening current sheet; where it sits is
# set by where the eta steps.
#
# Contract under test (see analysis_mhd_wall_eta_mode.py; the CTest
# twins select the mode on the CLI, this deck's default is neumann):
# - override (the reference twin): the eta table steps from the composed
#   plasma eta mu0*D to the override at the first masked E row (the
#   contour node included under dielectric), and the screening sheet
#   sits in the last live cells against that step;
# - neumann: the masked E rows within wall_band_eta_neumann_cells (= 3,
#   the default) of the contour carry EXACTLY the nearest live row's
#   composed eta (bit-equal to the plasma value here, asserted from the
#   plotted PC eta register in the flat wall sections), the override
#   only beyond; the sheet spreads from the last live cells into that
#   band while the total screening current stays comparable;
# - transparent: the last wall_band_eta_transparent_cells (= 3) live
#   rows carry the log-linear ramp eta_k = eta_c^(k/N) override^((N-k)/N)
#   (the analytic values asserted from the register), the sheet leaves
#   the ramp cells and forms at the first composed live cells.
# Every twin runs preconditioned with the MHD block PC's resistive block
# WITH assembly validation, so the residual/PC eta twin-ness of each
# mode is asserted inside the run itself at every update; the eta table
# is monotone from the plasma to the override in every row of every
# mode (no non-monotone kink anywhere, the stair step included).

my_constants.n0 = 1.0e18
my_constants.rho0 = n0 * m_p
my_constants.T0_ev = 100.0
my_constants.Tmin_ev = 2.0
my_constants.chi = 20.0
my_constants.B0 = 1.0e-3
my_constants.D = 20.0
my_constants.nr = 24
my_constants.nz = 12
my_constants.Lr = 0.5
my_constants.Lz = 0.5
my_constants.dt = 2.0e-5
my_constants.tau = 2.0e-4

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 6
amr.n_cell = nr nz
# z-only decomposition: the neumann source lookup reads the same-row live
# eta up to N cells inward, so every box must span the full radial domain
amr.max_grid_size_x = 24
amr.max_grid_size_y = 6
amr.max_level = 0

geometry.dims = RZ
warpx.n_rz_azimuthal_modes = 1
geometry.prob_lo = 0.0 -0.5*Lz
geometry.prob_hi = Lr 0.5*Lz
boundary.field_lo = none none
boundary.field_hi = pec none

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5

newton.verbose = true
newton.absolute_tolerance = 1.0e-14
newton.relative_tolerance = 1.0e-9
newton.max_iterations = 12
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-9
gmres.max_iterations = 1000

jacobian.pc_type = pc_mhd_block
pc_mhd_block.resistive_validate_assembly = 1

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = T0_ev
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.n_floor = 1.0e16
# Density-INDEPENDENT constant resistivity and no vacuum boost: the
# composed eta is exactly mu0*D at every live row, so the neumann band
# value and the transparent ramp values are analytic.
hybrid_pic_model.plasma_resistivity(rho,J,t) = mu0*D
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

# Uniform external Bz drive ramp through the split-field scheme
# (A_theta = (r/2) B0, scaled by t/tau): the shielding response is the
# screening sheet under test.
hybrid_pic_model.add_external_fields = 1
external_vector_potential.fields = drive
external_vector_potential.drive.Ay_external_grid_function(x,y,z) = "0.5 * x * B0"
external_vector_potential.drive.A_time_external_function(t) = "t/tau"
external_vector_potential.do_diva_cleaning = 0

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.mass_density_floor = 5.0e-4*rho0
implicit_mhd.electron_pressure_floor = 1.0e-4*n0*q_e*Tmin_ev
implicit_mhd.gamma_e = 5.0/3.0
implicit_mhd.gamma_i = 5.0/3.0
implicit_mhd.reference_ion_pressure = 0.0
implicit_mhd.mass_density(x,y,z) = rho0
implicit_mhd.electron_pressure(x,y,z) = "n0 * q_e * T0_ev"
implicit_mhd.evolve_ion_fluid = false
implicit_mhd.fluid_flux = central
implicit_mhd.viscosity = 1.0
implicit_mhd.include_joule_heating = false
implicit_mhd.thermal_diffusivity_electron = chi
implicit_mhd.resistive_theta = 1.0

implicit_mhd.wall_model = dielectric
implicit_mhd.wall_polyline_file = wall_step_r30_r22.csv
implicit_mhd.wall_thermal_bc = zero_flux
# The override value (500x the plasma eta; inlined for the unused-inputs
# check) and the treatment under test; the CTest twins override the mode
# on the CLI (override / transparent). The band widths keep their
# defaults (3 cells): a width key would be an input error in the twins.
implicit_mhd.wall_band_eta_override = mu0*1.0e4
implicit_mhd.wall_band_eta_mode = neumann

warpx.B_ext_grid_init_style = parse_b_ext_grid_function
warpx.Bx_external_grid_function(x,y,z) = 0.0
warpx.By_external_grid_function(x,y,z) = 0.0
warpx.Bz_external_grid_function(x,y,z) = 0.0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 6
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Br Bt Bz implicit_mhd_field_resistivity_e1 \
                       implicit_mhd_mass_density \
                       implicit_mhd_electron_energy \
                       implicit_mhd_momentum_r implicit_mhd_momentum_t \
                       implicit_mhd_momentum_z
diag1.write_species = 0
