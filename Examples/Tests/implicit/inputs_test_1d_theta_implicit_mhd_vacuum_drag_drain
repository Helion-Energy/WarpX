#################################
############ CONSTANTS ##########
#################################

# Uniform vacuum DUST (density below implicit_mhd.vacuum_mass_density)
# sliding along x at u0 in a uniform B along x (u x B = 0: no induction),
# periodic, with the vacuum drag nu switched on. Every flux divergence is
# zero, so the only dynamics is the drag: |m| decays and the kinetic energy
# with it. Without implicit_mhd.vacuum_drag_kinetic_drain the ion total
# energy E_i is untouched and the lost kinetic energy reappears as ion
# INTERNAL energy (the dust heats by 1/2 rho u0^2 (1 - e^{-2 nu t})); with
# the drain E_i loses exactly the kinetic decay and the internal energy is
# constant. nu = 0 (command line) is the null twin: bitwise identical under
# both settings.
my_constants.n0 = 1.0e18
my_constants.rho0 = n0 * m_p
my_constants.n_vac = 1.0e19
my_constants.rho_vac = n_vac * m_p
my_constants.Te = 10.0
my_constants.P0 = n0 * Te * q_e
my_constants.B0 = 0.1
my_constants.u0 = 2.0e4
my_constants.nu = 5.0e6
my_constants.nz = 32
my_constants.Lz = 1.0
my_constants.dt = 2.0e-8

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 10
amr.n_cell = nz
amr.max_grid_size = nz
amr.max_level = 0

geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = Lz
boundary.field_lo = periodic
boundary.field_hi = periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5

newton.verbose = true
newton.absolute_tolerance = 1.0e-14
newton.relative_tolerance = 1.0e-12
newton.max_iterations = 8
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-12
gmres.max_iterations = 200

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Te
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.n_floor = 1.0e8
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE ######
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = 5.0/3.0
implicit_mhd.gamma_i = 5.0/3.0
implicit_mhd.reference_ion_pressure = P0
implicit_mhd.mass_density(x,y,z) = rho0
implicit_mhd.electron_pressure(x,y,z) = P0
implicit_mhd.ion_pressure(x,y,z) = P0
implicit_mhd.velocity_x(x,y,z) = u0
implicit_mhd.evolve_ion_fluid = true
implicit_mhd.fluid_flux = central
implicit_mhd.viscosity = 1.0
implicit_mhd.ion_closure = total_energy
implicit_mhd.electron_pressure_floor = 1.0e-8
implicit_mhd.ion_pressure_floor = 1.0e-8
implicit_mhd.mass_density_floor = 1.0e-4*rho0
implicit_mhd.vacuum_mass_density = rho_vac
implicit_mhd.vacuum_drag_rate = nu

warpx.B_ext_grid_init_style = parse_B_ext_grid_function
warpx.Bx_external_grid_function(x,y,z) = B0
warpx.By_external_grid_function(x,y,z) = 0.0
warpx.Bz_external_grid_function(x,y,z) = 0.0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 10
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Bx By Bz implicit_mhd_mass_density implicit_mhd_momentum_x implicit_mhd_momentum_y implicit_mhd_momentum_z \
                       implicit_mhd_electron_energy implicit_mhd_ion_energy
diag1.write_species = 0
