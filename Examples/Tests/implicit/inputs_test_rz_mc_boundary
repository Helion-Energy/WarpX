# Native MC + full inertia, with real crossings at axis/wall/endcaps/MPI seam.
max_step = 10000
amr.n_cell = 32 64
amr.max_grid_size = 32
amr.blocking_factor = 8
amr.max_level = 0
geometry.dims = RZ
geometry.prob_lo = 0 -0.02
geometry.prob_hi = 0.02 0.02
boundary.field_lo = none neumann
boundary.field_hi = pec neumann
boundary.particle_lo = none fractional_absorbing
boundary.particle_hi = reflecting fractional_absorbing
boundary.particle_absorption_fraction = 0.05
boundary.verboncoeur_axis_correction = 1
warpx.const_dt = 1.e-10
warpx.verbose = 0
warpx.random_seed = 42317
warpx.serialize_initial_conditions = 1
warpx.synchronize_velocity_for_diagnostics = 0
warpx.use_filter = 1
warpx.filter_npass_each_dir = 1 1
warpx.rz_continuity_filter = 1
warpx.rz_adjoint_gather = 0
warpx.rz_continuity_audit_interval = 1
warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0 0 0.1
algo.maxwell_solver = hybrid
algo.evolve_scheme = explicit
algo.current_deposition = esirkepov
algo.field_gathering = momentum-conserving
algo.particle_shape = 3
hybrid_pic_model.elec_temp = 0
hybrid_pic_model.gamma = 1.6666666666666667
hybrid_pic_model.n0_ref = 1.e20
hybrid_pic_model.n_floor = 5.e18
hybrid_pic_model.density_pedestal = 1
hybrid_pic_model.density_pedestal_profile(x,y,z) = 5.e18
hybrid_pic_model.include_hall_term = 1
hybrid_pic_model.include_electron_pressure_term = 0
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0
hybrid_pic_model.plasma_hyper_resistivity(rho,B) = 0
hybrid_pic_model.include_electron_inertia_elliptic = 1
hybrid_pic_model.electron_inertia_relative_tolerance = 1.e-11
hybrid_pic_model.electron_inertia_max_iterations = 1000
hybrid_pic_model.electron_inertia_convection = 1
hybrid_pic_model.electron_inertia_moment_terms = 1
hybrid_pic_model.electron_inertia_momentum_flux = 1
hybrid_pic_model.center_field_moments = 1
hybrid_pic_model.energy_conserving_motional = 1
hybrid_pic_model.qdsmc_time_advance = pc
hybrid_pic_model.qdsmc_full_pedestal_transport = 1
hybrid_pic_model.qdsmc_source_stage_density = 1
hybrid_pic_model.substeps = 8
particles.species_names = ions_plus ions_minus
my_constants.clight = 299792458
mc_boundary.steps = 24
mc_boundary.require_escape = 1
mc_boundary.continuity_tolerance = 1.e-12
diagnostics.enable = 0

ions_plus.charge = q_e
ions_plus.mass = m_p
ions_plus.injection_style = NUniformPerCell
ions_plus.num_particles_per_cell_each_dim = 2 4 2
ions_plus.profile = constant
ions_plus.density = 5.e19
ions_plus.momentum_distribution_type = parse_momentum_function
ions_plus.momentum_function_ux(x,y,z) = if(x*x+y*y<0.01^2,-1,1)*2.e5*x/(clight*max(sqrt(x*x+y*y),1.e-12))
ions_plus.momentum_function_uy(x,y,z) = if(x*x+y*y<0.01^2,-1,1)*2.e5*y/(clight*max(sqrt(x*x+y*y),1.e-12))
ions_plus.momentum_function_uz(x,y,z) = 1.e6/clight

ions_minus.charge = q_e
ions_minus.mass = m_p
ions_minus.injection_style = NUniformPerCell
ions_minus.num_particles_per_cell_each_dim = 2 4 2
ions_minus.profile = constant
ions_minus.density = 5.e19
ions_minus.momentum_distribution_type = parse_momentum_function
ions_minus.momentum_function_ux(x,y,z) = if(x*x+y*y<0.01^2,-1,1)*2.e5*x/(clight*max(sqrt(x*x+y*y),1.e-12))
ions_minus.momentum_function_uy(x,y,z) = if(x*x+y*y<0.01^2,-1,1)*2.e5*y/(clight*max(sqrt(x*x+y*y),1.e-12))
ions_minus.momentum_function_uz(x,y,z) = -1.e6/clight
