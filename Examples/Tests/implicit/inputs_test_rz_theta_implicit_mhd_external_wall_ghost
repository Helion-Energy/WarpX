#################################
############ CONSTANTS ##########
#################################

my_constants.n0 = 1.0e20
my_constants.rho0 = n0 * m_p
my_constants.Te = 10.0
my_constants.Ti = 10.0
my_constants.Pe = n0 * Te * q_e
my_constants.Pi = n0 * Ti * q_e
my_constants.gamma = 5.0/3.0
my_constants.B0 = 0.01
my_constants.Brw = 0.2 * B0
my_constants.Cr = Brw / Lr
my_constants.Lr = 0.1
my_constants.Lz = 0.4
my_constants.nr = 16
my_constants.nz = 32
my_constants.sound_speed = sqrt(gamma*(Pe+Pi)/rho0)
my_constants.alfven_speed = B0 / sqrt(mu0*rho0)
# The time step is 1000x below the explicit CFL: every genuine response
# of the scheme to this configuration (see below) scales linearly with
# dt, while the ghost-gap injection this test guards against is
# dt-INDEPENDENT, so the tiny step separates them by three decades.
my_constants.dt = 2.5e-4 * (Lr/nr) / (sound_speed + alfven_speed)

#################################
####### GENERAL PARAMETERS ######
#################################

# External-field wall-ghost regression (RZ, hlld, open r boundary): a
# STATIC uniform plasma sits in a curl-free split external field
# A_theta = 0.5*B0*r + Cr*r*z, whose discrete curl is EXACTLY
# r-independent in B_z (= B0 + 2*Cr*z) and z-independent in B_r
# (= -Cr*r). Every staggered external-field jump the corner UCT EMF can
# see is therefore zero and u = 0 kills the four-state EMF average, so
# the assembled E_theta of the first residual evaluation vanishes --
# PROVIDED the r_max domain ghosts of the external B field hold their
# analytic values. The nonzero B_r threading the wall arms the
# rotational (UCT-HLLD) dissipation coefficient at every wall corner:
# an unfilled (alloc-zero) external-Bz ghost ring instead injects a
# dt-independent spurious E_theta ~ coefficient_r * B_z ~ 5-13 V/m at
# the wall ring from the first evaluation on. The genuine response of
# the scheme -- the zero-flux reflect wall takes the PEC-image
# (zero) tangential Maxwell stress while the interior faces carry the
# B_r*B_z stress of the tilted field, kicking the wall ring's momentum
# -- produces E_theta = -(u x B)_theta that scales LINEARLY with the
# (tiny) time step and stays ~4 decades below the injection here.
max_step = 2
amr.n_cell = nr nz
amr.max_grid_size = 24
amr.max_level = 0

geometry.dims = RZ
warpx.n_rz_azimuthal_modes = 1
geometry.prob_lo = 0.0 -0.5*Lz
geometry.prob_hi = Lr 0.5*Lz
boundary.field_lo = none none
boundary.field_hi = open none
boundary.particle_lo = none absorbing
boundary.particle_hi = reflecting absorbing

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 1.0

newton.verbose = true
newton.absolute_tolerance = 1.0e-11
newton.relative_tolerance = 1.0e-8
newton.max_iterations = 12
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-10
gmres.max_iterations = 300

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Te
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_velocity = 1.0e4
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = Pi
implicit_mhd.ion_closure = total_energy
implicit_mhd.mass_density_floor = 1.0e-4 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-4 * Pe
implicit_mhd.ion_pressure_floor = 1.0e-4 * Pi
implicit_mhd.fluid_flux = hlld
implicit_mhd.r_open_fluid = reflect
implicit_mhd.mass_density(x,y,z) = rho0
implicit_mhd.electron_pressure(x,y,z) = Pe
implicit_mhd.ion_pressure(x,y,z) = Pi

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 2
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Er Et Ez Br Bt Bz implicit_mhd_mass_density \
                       implicit_mhd_ion_energy implicit_mhd_electron_energy
diag1.write_species = 0

# Green's-function open boundary at r_hi with a zero-flux reflecting
# fluid wall: the exact configuration of the FRC open-wall holds whose
# wall corners read the external-Bz r_max ghost ring.
boundary.open_bc_coarsening = 4
boundary.open_bc_image_sum_rtol = 1.0e-6
boundary.open_bc_max_images = 200

# Split external vector potential: uniform-plus-tilted solenoid field.
# B_r = -Cr*r threads the open wall face (arming the rotational corner
# dissipation there) while B_z = B0 + 2*Cr*z stays exactly uniform in r,
# discretely as well as analytically. A pure-theta axisymmetric A is
# exactly divergence-free, so the MLMG cleaner (which rejects open BCs)
# stays off.
hybrid_pic_model.add_external_fields = 1
external_vector_potential.fields = bore
external_vector_potential.bore.Ay_external_grid_function(x,y,z) = "0.5*B0*x + Cr*x*z"
external_vector_potential.do_diva_cleaning = 0
