#################################
############ CONSTANTS ##########
#################################

# Density-keyed halo boost of the Braginskii chi_perp
# (implicit_mhd.conduction_halo_boost, the reference code's (en0/en)^2 low-density
# perp boost of ntb.f90 t_cond): a strongly magnetized 1D column
# (uniform Bx PERPENDICULAR to z, so all z conduction is cross-field)
# with two density zones -- bulk n0 in z < Lz/2 and a rarefied halo
# n_halo = 0.01 n0 in z >= Lz/2 -- and vacuum_reference_peak_fraction =
# 0.1, so the shared dynamic reference is n_ref = 0.1 n0 = 10 n_halo.
# Both zones carry the SAME on-ripple electron temperature profile
# Te = T0 (1 + a sin(k4 z)); the specific internal energy
# e = Te q_e/((gamma-1) m_p) is density-independent, so the zone
# interface carries no e-jump transient and each zone's ripple decays
# diffusively at its own effective cross-field chi:
#   - halo: chi_boost = D_boost (n_ref/n_halo)^2 = 100 D_boost = 100
#     m^2/s, five decades above the physical chi_perp_e ~ 1e-3 there
#     (chi_perp ~ n at fixed Te);
#   - bulk: chi_boost = D_boost (n_ref/n0)^2 = 0.01, entering the
#     quadrature composition below the physical chi_perp_e ~ 0.1 --
#     the bulk keeps physical Braginskii (< 1% change).
# The ion fluid is frozen (barotropic, evolve_ion_fluid = false), u = 0,
# J = 0, eta = 0: the electron energy sees the anisotropic conduction
# operator in isolation and the two windows measure the composed
# chi_perp directly against the implementation's own formula.
my_constants.n0 = 1.0e18
my_constants.n_halo = 1.0e16
my_constants.rho0 = n0 * m_p
my_constants.rho_halo = n_halo * m_p
my_constants.T0 = 10.0
my_constants.gamma = 5.0/3.0
# Bx = 0.05 T: Omega_e tau_e ~ 9.6e3 at (T0, n0) -> chi_perp_e ~ 0.1
# m2/s in the bulk
my_constants.B0 = 0.05
my_constants.nz = 64
my_constants.Lz = 1.0
my_constants.kz4 = 8*pi/Lz
# on-ripple temperature amplitude
my_constants.dTe = 0.05
# halo boost amplitude [m^2/s], reached AT the reference density
my_constants.D_boost = 1.0
# Reference = max(Ohm guard, 0.1 * n_peak) = 0.1 n0 (guard tiny)
my_constants.peak_fraction = 0.1
# ~30% halo ripple relaxation over 10 steps at chi_eff ~ 100 m^2/s
my_constants.dt = 5.7e-7

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 10
amr.n_cell = nz
amr.max_grid_size = 32
amr.max_level = 0

geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = Lz
boundary.field_lo = periodic
boundary.field_hi = periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5

newton.verbose = true
newton.absolute_tolerance = 1.0e-12
newton.relative_tolerance = 1.0e-10
newton.max_iterations = 20
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-10
gmres.max_iterations = 300

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = T0
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.mass_density_floor = 1.0e-6 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-8 * n0 * T0 * q_e
implicit_mhd.fluid_flux = central
implicit_mhd.viscosity = 0.5
implicit_mhd.evolve_ion_fluid = false
implicit_mhd.thermal_conduction_model = braginskii
implicit_mhd.conduction_coulomb_log = 10.0
implicit_mhd.conduction_halo_boost = D_boost
implicit_mhd.vacuum_reference_peak_fraction = peak_fraction
# rho: two-zone step; Te = T0 (1 + dTe sin(kz4 z)) in BOTH zones ->
# Pe = n Te q_e and e_spec = Te q_e/((gamma-1) m_p) is continuous
# across the zone interface (no interface transient)
implicit_mhd.mass_density(x,y,z) = if(z < Lz/2, rho0, rho_halo)
implicit_mhd.electron_pressure(x,y,z) = if(z < Lz/2, n0, n_halo) * T0 * (1.0 + dTe*sin(kz4*z)) * q_e

# Uniform TANGENTIAL field: bhat_n = 0 on every z face, so the
# Braginskii tensor reduces to pure chi_perp (+ the halo boost) along z;
# the electromagnetic subsystem is quiescent (u = 0 frozen, J = 0,
# eta = 0).
warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = B0 0.0 0.0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 10
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Bx jz implicit_mhd_mass_density \
                       implicit_mhd_electron_energy
diag1.write_species = 0
