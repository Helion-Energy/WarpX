#################################
############ CONSTANTS ##########
#################################

my_constants.n0 = 1.0e20
my_constants.rho0 = n0 * m_p
my_constants.Ti = 1.0
my_constants.Pi0 = n0 * Ti * q_e
my_constants.pe_over_pi = 1.0
my_constants.Pe0 = pe_over_pi * Pi0
my_constants.gamma = 5.0/3.0
my_constants.B0 = 1.0e-3
my_constants.u0 = 1.6e5
my_constants.nz = 64
my_constants.Lz = 1.0
my_constants.sound_speed = sqrt(gamma*(Pi0 + Pe0)/rho0)
my_constants.dt = 0.25 * (Lz/nz) / (u0 + sound_speed)
my_constants.rho_floor = 1.0e-2 * rho0
# Temperature-floor physics at CI scale: the halo of the supersonic
# rarefaction cools adiabatically (the electron temperature follows the
# adiabat, crossing T_floor at rho = 0.52 rho0; the ion temperature lags
# it through HLLC dissipation but crosses by rho ~ 0.2 rho0), far above
# the density floor. The temperature floors must hold both species at
# T >= T_floor instead. The run ends while the halo is still draining
# and pinned; past ~step 210 the shock reflux refills and reheats it.
my_constants.T_floor = 7500.0

#################################
####### GENERAL PARAMETERS ######
#################################

# A sinusoidal velocity profile rarefies half the periodic domain (a
# shock forms on the compression side; u0 is supersonic). The absolute
# pressure floors are set FAR below the temperature-floor equivalents,
# so the density-dependent n kB T_floor bound is the constraint that
# actually holds the drained halo.
max_step = 200
amr.n_cell = nz
amr.max_grid_size = 16
amr.max_level = 0

geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = Lz
boundary.field_lo = periodic
boundary.field_hi = periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 1.0

newton.verbose = true
newton.absolute_tolerance = 1.0e-11
newton.relative_tolerance = 1.0e-8
newton.max_iterations = 20
# Cells pinned at the temperature floor carry an irreducible residual
# (the kernels' smooth floors keep their absolute anchors by design, so
# the RHS has no closure at the temperature bound): accept the
# bound-projected iterate instead of demanding full convergence.
newton.require_convergence = false
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-10
gmres.max_iterations = 300

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = pe_over_pi * Ti
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_velocity = u0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = Pi0
implicit_mhd.ion_closure = total_energy
implicit_mhd.mass_density_floor = rho_floor
implicit_mhd.ion_pressure_floor = 1.0e-8 * Pi0
implicit_mhd.electron_pressure_floor = 1.0e-8 * Pi0
implicit_mhd.ion_temperature_floor = T_floor
implicit_mhd.electron_temperature_floor = T_floor
implicit_mhd.fluid_flux = hllc
implicit_mhd.mass_density(x,y,z) = rho0
implicit_mhd.ion_pressure(x,y,z) = Pi0
implicit_mhd.electron_pressure(x,y,z) = Pe0
implicit_mhd.velocity_z(x,y,z) = u0 * sin(2*pi*z/Lz)

# A uniform field keeps the electromagnetic subsystem quiescent.
warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.0 0.0 B0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 200
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Bz jx jy jz implicit_mhd_mass_density \
                       implicit_mhd_momentum_density \
                       implicit_mhd_ion_energy \
                       implicit_mhd_electron_energy
diag1.write_species = 0
