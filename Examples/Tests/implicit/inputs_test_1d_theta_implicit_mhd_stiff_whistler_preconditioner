#################################
############ CONSTANTS ##########
#################################

my_constants.n0 = 1.0e20
my_constants.rho0 = n0 * m_p
my_constants.Te = 10.0
my_constants.Pe = n0 * Te * q_e
my_constants.B0 = 0.1
my_constants.dB = 1.0e-4
my_constants.nz = 64
my_constants.Lz = 1.0
my_constants.k0 = 2*pi/Lz
my_constants.dz = Lz/nz
my_constants.hall_diffusivity = B0/(mu0*q_e*n0)
my_constants.whistler_cfl = 20.0
my_constants.dt = whistler_cfl*dz**2/hall_diffusivity

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 1
amr.n_cell = nz
amr.max_grid_size = 32
amr.max_level = 0

geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = Lz
boundary.field_lo = periodic
boundary.field_hi = periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5

newton.verbose = true
newton.absolute_tolerance = 1.0e-12
newton.relative_tolerance = 1.0e-10
newton.max_iterations = 8
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-10
gmres.max_iterations = 100

jacobian.pc_type = pc_mhd_block
pc_mhd_block.include_ideal_mhd_coupling = true
pc_mhd_block.include_hall_mhd_coupling = true
pc_mhd_block.field_iterations = 2
pc_mhd_block.fluid_iterations = 1
pc_mhd_block.agglomeration = true
pc_mhd_block.consolidation = true
pc_mhd_block.max_coarsening_level = 30

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Te
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = 5.0/3.0
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = true
hybrid_pic_model.include_electron_pressure_term = true

#################################
######## IMPLICIT MHD STATE ######
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = 5.0/3.0
implicit_mhd.gamma_i = 5.0/3.0
implicit_mhd.reference_ion_pressure = Pe
implicit_mhd.mass_density(x,y,z) = rho0
implicit_mhd.electron_pressure(x,y,z) = Pe
implicit_mhd.evolve_ion_fluid = false

warpx.B_ext_grid_init_style = parse_B_ext_grid_function
warpx.Bx_external_grid_function(x,y,z) = dB*(cos(k0*z)+0.7*cos(2*k0*z)-0.5*cos(4*k0*z)+0.35*cos(7*k0*z)-0.25*cos(11*k0*z)+0.18*cos(16*k0*z)+0.12*cos(21*k0*z)-0.08*cos(27*k0*z))
warpx.By_external_grid_function(x,y,z) = dB*(sin(k0*z)+0.7*sin(2*k0*z)-0.5*sin(4*k0*z)+0.35*sin(7*k0*z)-0.25*sin(11*k0*z)+0.18*sin(16*k0*z)+0.12*sin(21*k0*z)-0.08*sin(27*k0*z))
warpx.Bz_external_grid_function(x,y,z) = B0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 1
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Ex Ey Ez Bx By Bz implicit_mhd_mass_density \
                       implicit_mhd_momentum_density implicit_mhd_electron_energy
diag1.write_species = 0
