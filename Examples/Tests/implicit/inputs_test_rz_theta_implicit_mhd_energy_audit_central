#################################
# Global energy audit on a MAGNETIZED, FLOWING RZ column with the
# production flux stack (central flux, median reconstruction, the Rusanov
# channel dissipation, backward Euler, total-energy ions), a PEC outer
# wall and periodic z: the field-to-fluid exchange E.J is live (a
# theta-pinch-like axial field B_z(r) = B0 (1 + b exp(-(r/a)^2)) carrying
# the azimuthal current J_theta = -dB_z/dr, and a radial flow u_r(r, z)
# that works against J_theta B_z through the corner EMF E_theta = u_r B_z),
# so the Ohm's-law component split of the exchange remainder is exercised
# where the collocated 1D line cannot look: the RZ pairing between the
# edge ideal work (ideal_edge_work) and the cell-centered stress work
# (lorentz), its plain-mean and reconstruction parts, the corner (E_theta,
# UCT-averaged) term and the r-weights/axis of the edge sums. Run at two
# resolutions (my_constants nr, nz overridden by the fine registration;
# same dt, same steps) the mismatch must converge. The current vanishes
# at the wall like exp(-16), so the PEC projection's work (ohm_rest) is
# negligible here. (WarpX's RZ field parser initializes B_z(r, z) only --
# B_r and B_theta are hardcoded zero and a high-priority warning says so;
# this deck therefore sets no abort threshold.)
#################################
my_constants.n0 = 1.0e19
my_constants.rho0 = n0 * m_p
my_constants.T0_ev = 50.0
my_constants.P0 = n0 * T0_ev * q_e
my_constants.gamma = 5.0/3.0
my_constants.B0 = 0.05
my_constants.b = 0.2
my_constants.a = 0.025
my_constants.u0 = 2.0e4
my_constants.Lr = 0.1
my_constants.Lz = 0.4
my_constants.nr = 16
my_constants.nz = 32
my_constants.dt = 2.0e-9
my_constants.nsteps = 8

#################################
####### GENERAL PARAMETERS ######
#################################
max_step = nsteps
amr.n_cell = nr nz
amr.max_grid_size = 16
amr.max_level = 0
geometry.dims = RZ
warpx.n_rz_azimuthal_modes = 1
geometry.prob_lo = 0.0 -0.5*Lz
geometry.prob_hi = Lr 0.5*Lz
boundary.field_lo = none periodic
boundary.field_hi = pec periodic
boundary.particle_lo = none periodic
boundary.particle_hi = reflecting periodic
warpx.verbose = 1
warpx.const_dt = dt

#################################
############ SOLVER #############
#################################
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd
implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 1.0
newton.verbose = true
newton.absolute_tolerance = 1.0e-11
newton.relative_tolerance = 1.0e-8
newton.max_iterations = 20
newton.require_convergence = false
newton.diagnostic_file = diags/newton.txt
gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-9
gmres.max_iterations = 300

hybrid_pic_model.elec_temp = T0_ev
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = P0
implicit_mhd.mass_density_floor = 1.0e-6 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-6 * P0
implicit_mhd.ion_pressure_floor = 1.0e-6 * P0
implicit_mhd.fluid_flux = central
implicit_mhd.fluid_reconstruction = median
implicit_mhd.central_dissipation = 1.0
implicit_mhd.viscosity = 0.5
implicit_mhd.ion_closure = total_energy
implicit_mhd.include_joule_heating = true
# the global energy audit, every step (this deck exists for it)
implicit_mhd.energy_audit_file = diags/energy_audit.txt
implicit_mhd.energy_audit_interval = 1

#################################
######## INITIAL STATE ##########
#################################
implicit_mhd.mass_density(x,y,z) = "rho0"
implicit_mhd.ion_pressure(x,y,z) = "P0"
implicit_mhd.electron_pressure(x,y,z) = "P0"
# radial flow, zero on the axis and (exponentially) at the wall
implicit_mhd.velocity_x(x,y,z) = "u0 * (x/a) * exp(-(x/a)^2) * sin(2*pi*z/Lz)"
# theta-pinch-like axial field: B_z = B0 (1 + b exp(-(r/a)^2)), J_theta = -dB_z/dr = 2 B0 b (r/a^2) exp(-(r/a)^2)/mu0
warpx.B_ext_grid_init_style = parse_b_ext_grid_function
warpx.Bx_external_grid_function(x,y,z) = "0.0"
warpx.By_external_grid_function(x,y,z) = "0.0"
warpx.Bz_external_grid_function(x,y,z) = "B0 * (1 + b * exp(-(x/a)^2))"

#################################
########## DIAGNOSTICS ##########
#################################
diagnostics.diags_names = diag1
diag1.intervals = nsteps
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Br Bt Bz implicit_mhd_mass_density implicit_mhd_electron_energy \
                       implicit_mhd_ion_energy implicit_mhd_momentum_r implicit_mhd_momentum_t \
                       implicit_mhd_momentum_z
