#################################
# ENGINEERED ACTIVE-SET CHURN (reduced-space Newton) -- the production
# wall-row mechanism distilled: a 100 eV plasma against a 2 eV conducting
# z-end wall (Braginskii conduction, central flux, dual-energy ion closure)
# with an ION TEMPERATURE FLOOR of 50 eV between the wall and the plasma
# temperature, and a conduction diffusion number of 10 per step (dt = 10
# dz^2/chi). The wall drain takes the wall-adjacent ion internal energy U_i
# (and E_i) below the floor image every step, so the wall row is pinned;
# conduction from the hot interior refills it and the dual-energy pair
# couples the two carriers of the same cell. Measured with
# newton.active_set = 1 (plain release rule): the identification drops the
# pinned wall row at iterations 0-2 of most solves (its residual points
# inward at the new time level and after the neighbours' update) and the
# same iteration's free direction drives it back through the bound, where
# the projection re-clamps it -- 128 releases and 128 re-entrants after
# iteration 0 over 28 steps on a set of 16-32 components, one wasted Newton
# iteration per churning solve, and (with the strict policy) a line-search
# failure by step 28. This is the signature of the production formation
# deck's 14-17 us windows (170 releases and 169 entrants per step on a set
# of ~125; 25% damped iterations, 17% stagnation exits). The tolerant policy
# lets the control run record its stagnation exits instead of aborting.
#
# Consumers: test_rz_theta_implicit_mhd_wall_active_set_churn (the plain
# active-set control with the globalization counters recorded) and
# test_rz_theta_implicit_mhd_wall_active_set_hysteresis (the release
# hysteresis + entrant re-solve) -- see analysis_mhd_wall_active_set_churn.py.
#################################

#################################
############ CONSTANTS ##########
#################################

my_constants.n0 = 1.0e18
my_constants.rho0 = n0 * m_p
my_constants.T0_ev = 100.0
my_constants.Twall_ev = 2.0
my_constants.Pe0 = n0 * T0_ev * q_e
my_constants.Pi0 = n0 * T0_ev * q_e
my_constants.gamma = 5.0/3.0
my_constants.B0 = 0.05
my_constants.Lr = 0.1
my_constants.Lz = 1.0
my_constants.nr = 8
my_constants.nz = 64
my_constants.dz = Lz / nz
# Braginskii par-channel cap, DEFINED (kappa/(n kB)) convention; the
# operator diffusivity is (gamma - 1) * chi_cap. The raw chi_par of both
# species stays far above the cap over the whole run (>= 5x at the
# coldest end-face temperature reached), so the soft cap's tanh knee is
# saturated and the effective diffusivity is (gamma - 1) * chi_cap to
# machine precision -- the end-drain rate is analytic. The cap is chosen
# large enough that the acoustic response to the end cooling stays
# inside the first cell over the run (c_s t / dz ~ 0.4), keeping the
# advective contamination of the conduction gate small.
my_constants.chi_cap = 4.0e4
my_constants.chi_op = (gamma - 1.0) * chi_cap
# conduction-paced step: chi_op dt / dz^2 = 0.5 (end-face Dirichlet rate
# 2 chi_op dt / dz^2 = 1 per step); Alfven CFL v_A dt/dz ~ 0.3, sound
# CFL ~ 0.05 -- far below the matrix-free Newton degradation threshold.
# Stiff conduction step, as the production deck (diffusion number 10).
my_constants.dt = 10.0 * dz^2 / chi_op
# Ion temperature floor between the wall (2 eV) and the plasma (100 eV):
# the wall row pins under the wall drain. In kelvin: 50 eV.
my_constants.T_floor_ion = 580220.0

#################################
####### GENERAL PARAMETERS ######
#################################

# Conductive z-end exchange (implicit_mhd.z_wall_conduction): a hot
# static uniform column (T0 = 100 eV both species) with B ALONG z
# (bn = 1 on the z end faces -> the PARALLEL channel) against cold
# wall_temperature ends. With the knob ON both end faces carry the hard
# half-cell Dirichlet conductive exchange chi rho (e - e_wall) 2/dz at
# the cap-pinned chi_par, so the column must cool as the exact
# backward-Euler diffusion column with half-cell Dirichlet end baths;
# the knob-OFF null twin must instead match the LEGACY end faces -- the
# plain tensor branch against the wall-image ghost at the one-cell
# Neumann-ghost distance (chi rho (e - e_wall)/dz, a 2x slower end
# exchange). The analysis integrates the identical discrete operator
# for each mode.
max_step = 16
amr.n_cell = nr nz
amr.max_grid_size = 32
amr.max_level = 0

geometry.dims = RZ
warpx.n_rz_azimuthal_modes = 1
geometry.prob_lo = 0.0 -0.5
geometry.prob_hi = Lr 0.5
boundary.field_lo = none none
boundary.field_hi = pec none
boundary.particle_lo = none absorbing
boundary.particle_hi = reflecting absorbing

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 1.0

newton.verbose = true
newton.absolute_tolerance = 1.0e-11
# Loosened from the base deck's 1e-8: the churn (releases and re-entrants at
# iterations 0-2) is fully present at 1e-6 and the run stays in the regime
# the test measures (with 1e-8 the wall row degenerates past step 28:
# damped and stagnating solves, then divergence at step ~32 in every arm).
newton.relative_tolerance = 1.0e-6
newton.max_iterations = 20
# Tolerant policy: the churning control stagnates in some solves; record
# the stagnation exits (status 1) instead of aborting.
newton.require_convergence = false
# Reduced-space Newton: the mode this deck exercises.
newton.active_set = 1
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-8
gmres.max_iterations = 300

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = T0_ev
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = Pi0
implicit_mhd.mass_density_floor = 1.0e-4 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-4 * Pe0
implicit_mhd.ion_pressure_floor = 1.0e-4 * Pi0
implicit_mhd.fluid_flux = central
implicit_mhd.viscosity = 0.5
implicit_mhd.ion_closure = dual_energy
implicit_mhd.ion_temperature_floor = T_floor_ion
implicit_mhd.z_boundary_fluid = wall_temperature
implicit_mhd.z_wall_temperature = Twall_ev
implicit_mhd.z_wall_conduction = 1
implicit_mhd.thermal_conduction_model = braginskii
implicit_mhd.conduction_coulomb_log = 10.0
implicit_mhd.conduction_chi_par_max = chi_cap
implicit_mhd.conduction_chi_perp_max = chi_cap
implicit_mhd.mass_density(x,y,z) = rho0
implicit_mhd.electron_pressure(x,y,z) = Pe0
implicit_mhd.ion_pressure(x,y,z) = Pi0

warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.0 0.0 B0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 16
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Bz implicit_mhd_mass_density \
                       implicit_mhd_electron_energy implicit_mhd_ion_energy \
                       implicit_mhd_ion_internal_energy \
                       implicit_mhd_momentum_r implicit_mhd_momentum_t \
                       implicit_mhd_momentum_z
diag1.write_species = 0
