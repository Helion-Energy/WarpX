#################################
############ CONSTANTS ##########
#################################
# Global energy audit on a closed system: the circularly polarized Alfven
# wave (an exact nonlinear ideal-MHD solution) on a periodic line with the
# production conservative flux (central), total-energy ions, no walls, no
# drive, no floors engaged, no pedestal, no dual-energy sync. Nothing
# enters or leaves, so the audit's 'booked' residual IS the scheme's
# non-conservation (the theta-quadrature term of the Faraday update, the
# field-to-fluid exchange mismatch between the edge E.J and the
# cell-centered stress work, the Newton tolerance), and its 'full'
# residual -- every named term subtracted -- must sit at round-off.
# implicit_evolve.theta is overridden by the registrations: at 1/2 the
# theta term vanishes identically; at 1 (backward Euler) it is the
# dissipation (theta - 1/2) sum |dB|^2/mu0 > 0, whose total over a fixed
# time interval scales linearly with dt (twin at half the step).
my_constants.n0 = 1.0e20
my_constants.rho0 = n0 * m_p
my_constants.Ti = 100.0
my_constants.P0 = n0 * Ti * q_e
my_constants.gamma = 5.0/3.0
my_constants.pe_over_pi = 1.0e-3
my_constants.B0 = sqrt(mu0 * P0)
my_constants.db = 0.1 * B0
my_constants.vA = B0 / sqrt(mu0 * rho0)
my_constants.dvperp = db / sqrt(mu0 * rho0)
my_constants.nz = 64
my_constants.Lz = 1.6
my_constants.kz = 2 * pi / Lz
my_constants.t_end = 0.25 * Lz / vA
my_constants.nsteps = 40
my_constants.dt = t_end / nsteps

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = nsteps
amr.n_cell = nz
amr.max_grid_size = 32
amr.max_level = 0

geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = Lz
boundary.field_lo = periodic
boundary.field_hi = periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5

newton.verbose = true
newton.absolute_tolerance = 0.0
newton.relative_tolerance = 1.0e-12
newton.max_iterations = 20
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-12
gmres.max_iterations = 400

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = pe_over_pi * Ti
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = P0
implicit_mhd.ion_closure = total_energy
implicit_mhd.ion_pressure_floor = 1.0e-6 * P0
implicit_mhd.mass_density_floor = 1.0e-6 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-9 * P0
implicit_mhd.fluid_flux = central
# the central flux needs an explicit viscosity (no Riemann dissipation):
# a small kinematic value, nu k^2 t_end ~ 6e-5, conservative by
# construction (the stress work stays in E_i)
implicit_mhd.viscosity = 1.0
implicit_mhd.include_joule_heating = true
implicit_mhd.mass_density(x,y,z) = "rho0"
implicit_mhd.ion_pressure(x,y,z) = "P0"
implicit_mhd.electron_pressure(x,y,z) = "pe_over_pi * P0"
# Walen condition for a +z-propagating Alfven wave:
# du_perp = -dB_perp / sqrt(mu0 rho0)
implicit_mhd.velocity_x(x,y,z) = "-dvperp * cos(kz * z)"
implicit_mhd.velocity_y(x,y,z) = "-dvperp * sin(kz * z)"

warpx.B_ext_grid_init_style = parse_b_ext_grid_function
warpx.Bx_external_grid_function(x,y,z) = "db * cos(kz * z)"
warpx.By_external_grid_function(x,y,z) = "db * sin(kz * z)"
warpx.Bz_external_grid_function(x,y,z) = "B0"

# The audit under test.
implicit_mhd.energy_audit_file = diags/energy_audit.txt
implicit_mhd.energy_audit_interval = 1

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = nsteps
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Bx By Bz implicit_mhd_mass_density \
                       implicit_mhd_ion_energy implicit_mhd_electron_energy
diag1.write_species = 0
