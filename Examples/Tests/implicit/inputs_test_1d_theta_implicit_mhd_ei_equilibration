#################################
############ CONSTANTS ##########
#################################

my_constants.n0 = 2.0e20
# Formation-class two-temperature split (the measured RZ formation-arm
# medians): hot electrons relax against cold ions. The reverse variant
# overrides Te0/Ti0 from the command line (cold electrons, Te0 = 5 eV,
# which also exercises the low-Te Coulomb-logarithm branch).
my_constants.Te0 = 44.0
my_constants.Ti0 = 12.0
my_constants.rho0 = n0 * m_p
my_constants.pe0 = n0 * Te0 * q_e
my_constants.pi0 = n0 * Ti0 * q_e
my_constants.gamma = 5.0/3.0
my_constants.B0 = sqrt(mu0 * (pe0 + pi0))
# Uniform static two-temperature state: every flux and work term is
# exactly inert (uniform, u = 0, B = 0, eta = 0), so the ONLY dynamics
# is the reference code's eq_brate electron-ion exchange
#   dU_e/dt = +nu (p_i - p_e) = -dE_i/dt,
# under which d = p_i - p_e decays through the theta-discrete factor of
# K = (gamma_e + gamma_i - 2) nu, with nu FROZEN per step from the
# step-old (n, Te) -- Te changes as the pair relaxes, so the analysis
# replicates the per-step frozen-rate recurrence rather than a single
# exponential. p_e + p_i (and U_e + E_i) are conserved to round-off.
# nu0 below is the initial reference-code rate (Te0 = 44 eV sits on the
# high-Te lnLambda branch); the deck's dt puts K dt ~ 0.13.
my_constants.lnL0 = 24 + 3*log(10) - 0.5*log(n0) + log(Te0)
my_constants.nu0 = 4.75e-15 * lnL0 * n0 / (Te0 * sqrt(Te0))
my_constants.dt = 0.1 / ((2*gamma - 2) * nu0)
my_constants.nz = 16
my_constants.Lz = 0.2

max_step = 30
amr.n_cell = nz
amr.max_grid_size = 16
amr.max_level = 0

geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = Lz
boundary.field_lo = periodic
boundary.field_hi = periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5

newton.verbose = true
newton.absolute_tolerance = 1.0e-12
newton.relative_tolerance = 1.0e-10
newton.max_iterations = 20

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-10
gmres.max_iterations = 400

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Te0
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = pi0
implicit_mhd.ion_closure = total_energy
implicit_mhd.electron_ion_equilibration = 1.0
implicit_mhd.ion_pressure_floor = 1.0e-8 * pi0
implicit_mhd.mass_density_floor = 1.0e-6 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-8 * pe0
implicit_mhd.fluid_flux = central
# the central flux requires explicit viscosity (production pairing);
# with u = 0 uniform it is exactly inert here
implicit_mhd.viscosity = 1.0
implicit_mhd.mass_density(x,y,z) = rho0
implicit_mhd.ion_pressure(x,y,z) = pi0
implicit_mhd.electron_pressure(x,y,z) = pe0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 30
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = implicit_mhd_mass_density \
                       implicit_mhd_ion_energy \
                       implicit_mhd_electron_energy
diag1.write_species = 0
