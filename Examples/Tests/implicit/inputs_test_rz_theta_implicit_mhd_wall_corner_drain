#################################
############ CONSTANTS ##########
#################################

# Shaped-wall CORNER conductance test (RZ, central recast flux, frozen
# ions): a static UNIFORM hot column (T0 = 100 eV) sits inside a
# stepped conducting wall (r_w = 0.30 m for z < 0, 0.22 m for z > 0)
# whose cold Dirichlet thermal pin (wall_thermal_bc = dirichlet, the
# UNCAPPED half-cell exchange) is combined with the conductive z-end
# exchange (implicit_mhd.z_wall_conduction) against the same 2 eV bath.
#
# The geometry deliberately manufactures BOTH corner families a live
# fluid cell can sit in:
#
#   * stair corner   (i = 18, j = 7): masked in +r (the r_w = 0.30
#     cylinder) AND masked in +z (the ledge of the step down to
#     r_w = 0.22) -- two shaped-wall Dirichlet faces, both from the
#     wall_face branch of ComputeDirectionalFaceFluxes.
#   * z-end corner   (i = 13, j = 15): masked in +r (the r_w = 0.22
#     cylinder) AND sitting on the z_hi domain end face -- one
#     shaped-wall Dirichlet face plus one z_wall_conduction end face,
#     i.e. the two INDEPENDENT drain code paths on orthogonal faces of
#     one cell (the EB-meets-z_hi corner).
#
# Flat single-face references sit at the same radius as each corner
# (i = 18, j = 4 and i = 13, j = 10 carry the r-face only; i = 17,
# j = 7 carries the z-ledge face only; i = 5, j = 15 carries the z-end
# face only), so the corner/flat drain ratios isolate the corner
# contract from every radius- and metric-dependent factor.
#
# Only isotropic constant-chi ELECTRON conduction is alive: eta = 0, no
# Hall, no electron-pressure Ohm term, no Joule heating, frozen ions and
# u = 0, so the centered flux carries exactly nothing and the electron
# energy obeys the pure heat equation. The analysis integrates the same
# discrete backward-Euler operator and gates the corner cells against
# it.

my_constants.n0 = 1.0e20
my_constants.rho0 = n0 * m_p
my_constants.T0_ev = 100.0
my_constants.Twall_ev = 2.0
my_constants.chi = 20.0
my_constants.gamma = 5.0/3.0
my_constants.B0 = 0.01
my_constants.Lr = 0.5
my_constants.Lz = 0.25
my_constants.nr = 32
my_constants.nz = 16
# dr = dz = 0.015625 m, so the two staircase face metrics differ only
# through the RZ radial area factor r_face/r_cell.
my_constants.dz = Lz / nz
# conduction-paced step: chi dt / dz^2 = 0.02, so a single flat wall
# face carries the half-cell diffusion number 2 chi dt / dz^2 = 0.04.
# Small enough that the corner/flat drain ratio stays in the LINEAR
# regime (where the two contracts are maximally separated, 1.97 vs
# 1.40) and the cooling front never leaves the wall-adjacent ring; the
# 4% end-cell drop is still six orders above the double-precision
# plotfile noise.
my_constants.dt = 0.02 * dz^2 / chi

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 2
amr.n_cell = nr nz
amr.max_grid_size = 16
amr.max_level = 0

geometry.dims = RZ
warpx.n_rz_azimuthal_modes = 1
geometry.prob_lo = 0.0 -0.5*Lz
geometry.prob_hi = Lr 0.5*Lz
boundary.field_lo = none none
boundary.field_hi = pec none
boundary.particle_lo = none absorbing
boundary.particle_hi = reflecting absorbing

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 1.0

newton.verbose = true
newton.absolute_tolerance = 1.0e-12
newton.relative_tolerance = 1.0e-10
newton.max_iterations = 20
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-12
gmres.max_iterations = 300

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = T0_ev
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = 0.0
implicit_mhd.mass_density_floor = 1.0e-4 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-6 * n0 * Twall_ev * q_e
implicit_mhd.evolve_ion_fluid = false
implicit_mhd.fluid_flux = central
# central-flux stabilization guard; inert here (frozen ions, u = 0)
implicit_mhd.viscosity = 1.0
implicit_mhd.include_joule_heating = false
implicit_mhd.thermal_diffusivity_electron = chi
implicit_mhd.mass_density(x,y,z) = rho0
implicit_mhd.electron_pressure(x,y,z) = n0 * q_e * T0_ev

# Stepped conducting wall with the UNCAPPED Dirichlet thermal pin.
implicit_mhd.wall_model = pec
implicit_mhd.wall_polyline_file = wall_step_r30_r22.csv
implicit_mhd.wall_thermal_bc = dirichlet
implicit_mhd.wall_temperature = Twall_ev

# Conductive z-end exchange against the same bath: the z_hi end face of
# the last live ring is the second, INDEPENDENT drain of the z-end
# corner cell.
implicit_mhd.z_boundary_fluid = wall_temperature
implicit_mhd.z_wall_temperature = Twall_ev
implicit_mhd.z_wall_conduction = 1

warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.0 0.0 B0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 1
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = implicit_mhd_mass_density \
                       implicit_mhd_electron_energy
diag1.write_species = 0
