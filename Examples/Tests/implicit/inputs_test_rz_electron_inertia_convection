# Small native manufactured and full-Ohm convection fixture.
max_step = 4
amr.n_cell = 32 16
amr.max_grid_size = 8
amr.blocking_factor = 4
amr.max_level = 0
geometry.dims = RZ
geometry.prob_lo = 0.0 -0.0375
geometry.prob_hi = 0.3 0.0375
boundary.field_lo = none pmc
boundary.field_hi = pec pmc
boundary.particle_lo = none absorbing
boundary.particle_hi = reflecting absorbing
warpx.verbose = 0
warpx.const_dt = 1.e-11
warpx.serialize_initial_conditions = 1
warpx.use_filter = 0
warpx.abort_on_warning_threshold = high
algo.maxwell_solver = hybrid
algo.particle_shape = 1
algo.current_deposition = direct
hybrid_pic_model.elec_temp = 100.0
hybrid_pic_model.n0_ref = 1.e19
hybrid_pic_model.gamma = 1.6666666666666667
hybrid_pic_model.n_floor = 5.e17
hybrid_pic_model.include_hall_term = 0
hybrid_pic_model.include_electron_pressure_term = 0
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.plasma_hyper_resistivity(rho,B) = 0.0
hybrid_pic_model.substeps = 2
hybrid_pic_model.solve_electron_energy_equation = 1
hybrid_pic_model.include_joule_heating = 0
hybrid_pic_model.qdsmc_time_advance = pc
hybrid_pic_model.include_electron_inertia_elliptic = 1
hybrid_pic_model.electron_inertia_relative_tolerance = 1.e-11
hybrid_pic_model.electron_inertia_max_iterations = 1000
hybrid_pic_model.density_pedestal = 1
hybrid_pic_model.density_pedestal_track_floor = 1
particles.species_names = ions
ions.charge = q_e
ions.mass = m_p
ions.injection_style = NUniformPerCell
ions.num_particles_per_cell_each_dim = 1 1 1
ions.profile = constant
ions.density = 1.e19
ions.momentum_distribution_type = constant
ions.ux = 0.0
ions.uy = 0.0
ions.uz = 0.0
ions.do_not_push = 1
