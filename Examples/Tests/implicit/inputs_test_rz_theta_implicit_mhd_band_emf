#################################
############ CONSTANTS ##########
#################################

# The EMF side of the band-cells force mask (implicit_mhd.lorentz_force_band_emf).
#
# The external-current wall column (uniform B_z = B0 plus the split external
# field A_theta = c_ext r^3, B_z,ext = 4 c_ext r^2 with its in-domain current
# j_theta,ext = -8 c_ext r/mu0, the flat dielectric shaped wall at r = 0.065,
# masked cells i >= 10 of 16, open z ends) given a linear RADIAL flow u_r =
# u1 r/Lr. The flow compresses the field through the corner EMF E_theta =
# u_r B_z,total: dB_z/dt = -(1/r) d(r u_r B_z)/dr = -(u1/Lr)(2 B0 + 16 c_ext
# r^2) in every cell whose four corner EMFs read live velocities (the
# evolved B_z is the plasma response; the external field is static). Under
# lorentz_force_current = total the fluid feels the external current's force
# f_r = j_theta,ext B_z,total, so the band cells -- force-free under the mask,
# moving at u_r -- carry a nonzero withheld work u_r f_r that the audit books.
# eta = 0 and no vacuum boost: the field is ideal.
#
# The band-cells mask (N = 2: cells 8-9 force-free) is on in both arms.
# "live" (lorentz_force_band_emf = 0, today's behaviour): the band fluid
# still advects the field -- B_z in cells 8-9 changes like the interior's
# (the wall-adjacent cell 9 at a reduced rate: its wall corners average the
# masked cells' frozen state in) and the audit books the band's withheld
# force work as force_withheld.
# "frozen" (lorentz_force_band_emf = 1, command line): the band cells'
# velocity is frozen in the induction EMF -- every corner of cell 9 reads
# only band or masked cells, so its B_z does not move at all; the inner
# interior (cells 1-5, more than one fast-signal length from the band over
# the run) is the live arm's; force_withheld is exactly zero and the band's
# withheld work is reported as emf_withheld (the live arm's force_withheld).
# See analysis_mhd_force_band_emf.py.
my_constants.n0 = 1.0e20
my_constants.rho0 = n0 * m_p
my_constants.T0_ev = 50.0
my_constants.P0 = n0 * T0_ev * q_e
my_constants.gamma = 5.0/3.0
my_constants.B0 = 0.05
my_constants.c_ext = 0.25
my_constants.u1 = 1.0e4
my_constants.Lr = 0.1
my_constants.Lz = 0.05
my_constants.nr = 16
my_constants.nz = 8
my_constants.dt = 2.0e-9

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 16
amr.n_cell = nr nz
amr.max_grid_size = 16
amr.max_level = 0

geometry.dims = RZ
warpx.n_rz_azimuthal_modes = 1
geometry.prob_lo = 0.0 -0.5*Lz
geometry.prob_hi = Lr 0.5*Lz
boundary.field_lo = none none
boundary.field_hi = pec none
boundary.particle_lo = none absorbing
boundary.particle_hi = reflecting absorbing

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5

newton.verbose = true
newton.absolute_tolerance = 1.0e-12
newton.relative_tolerance = 1.0e-11
newton.max_iterations = 12
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-11
gmres.max_iterations = 300

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = T0_ev
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

# The split external field: A_theta = c_ext r^3 (x is r in the RZ parser),
# curl curl A nonzero inside the domain (the parent deck's in-domain
# external current), static in time.
hybrid_pic_model.add_external_fields = 1
external_vector_potential.fields = sheet
external_vector_potential.sheet.Ay_external_grid_function(x,y,z) = "c_ext*x*x*x"
external_vector_potential.sheet.A_time_external_function(t) = "1.0"
external_vector_potential.do_diva_cleaning = 0

#################################
######## IMPLICIT MHD STATE ######
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = P0
implicit_mhd.mass_density_floor = 1.0e-6 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-6 * P0
implicit_mhd.ion_pressure_floor = 1.0e-6 * P0
implicit_mhd.fluid_flux = central
implicit_mhd.viscosity = 0.5
implicit_mhd.ion_closure = total_energy
implicit_mhd.mass_density(x,y,z) = rho0
implicit_mhd.electron_pressure(x,y,z) = P0
implicit_mhd.ion_pressure(x,y,z) = P0
implicit_mhd.velocity_x(x,y,z) = u1 * x/Lr

# The flat dielectric shaped wall, the band-cells force mask (N = 2, under
# the parent's total-stress force so the external current pushes the live
# fluid) and its EMF knob (0 = today's behaviour; the frozen arm overrides
# it on the command line), and the energy audit.
implicit_mhd.wall_model = dielectric
implicit_mhd.wall_polyline_file = wall_flat_r065.csv
implicit_mhd.wall_thermal_bc = zero_flux
implicit_mhd.lorentz_force_band_cells = 2
implicit_mhd.lorentz_force_band_emf = 0
implicit_mhd.energy_audit_file = diags/energy_audit.txt
implicit_mhd.energy_audit_interval = 1

# The uniform evolved state field (the plasma response carries no current
# at t = 0).
warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.0 0.0 B0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 16
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = Br Bt Bz implicit_mhd_mass_density \
                       implicit_mhd_electron_energy implicit_mhd_ion_energy \
                       implicit_mhd_momentum_r implicit_mhd_momentum_t implicit_mhd_momentum_z
diag1.write_species = 0
