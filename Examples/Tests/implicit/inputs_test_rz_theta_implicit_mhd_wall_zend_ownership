#################################
############ CONSTANTS ##########
#################################

# OWNERSHIP of the z_hi domain end face where the shaped wall runs into
# it (RZ, central recast flux, frozen ions).
#
# The wall contour steps inward EXACTLY at the z_hi plane (r_w = 0.30 m
# for z < 0.125, 0.20 m beyond), the production formation geometry in
# miniature: the contour is still cutting inward as it crosses the end
# plane. The mask's per-z first-masked table is built over the mask's
# GHOST rows too, and every face classifier reads it at the ghost cell
# just outside a z domain face -- so without a precedence rule the
# boundary condition of a DOMAIN face is decided by wall geometry
# OUTSIDE the simulated volume, and the last live z row splits mid-row:
# cells "under the overhang" (i = 13..18 here, whose z_hi ghost
# neighbour is masked) take the shaped-wall interface contract (absorb
# image, wall_temperature bath, wall_conduction_scale chi clamp, wall
# cap/rectifier rules) while their neighbours on the SAME face take the
# z-end contract (z_wall_temperature, tensor chi, uncapped).
#
# The two baths are deliberately on OPPOSITE sides of the column
# temperature -- T_wall = 2 eV, z_wall_temperature = 200 eV, T0 = 100 eV
# -- so a split face is unmistakable: the contended cells COOL while
# their neighbours HEAT, on one flat domain boundary.
#
# Contract: the mask's authority stops at the domain. A z domain face is
# classified by its INTERIOR cell alone; the mask still wins for every
# cell it claims in-domain, and the z boundary condition applies exactly
# to the cells the mask does not claim. Every live cell of the last z
# row that the mask does not claim must therefore exchange with the
# z-end reservoir and HEAT.
#
# Only isotropic constant-chi ELECTRON conduction is alive (eta = 0, no
# Hall, no electron-pressure Ohm term, no Joule heating, frozen ions,
# u = 0), so nothing but the boundary contracts can move the energy.

my_constants.n0 = 1.0e20
my_constants.rho0 = n0 * m_p
my_constants.T0_ev = 100.0
my_constants.Twall_ev = 2.0
my_constants.Tzend_ev = 200.0
my_constants.chi = 20.0
my_constants.gamma = 5.0/3.0
my_constants.B0 = 0.01
my_constants.Lr = 0.5
my_constants.Lz = 0.25
my_constants.nr = 32
my_constants.nz = 16
my_constants.dz = Lz / nz
# linear regime: a single half-cell exchange carries 2 chi dt/dz^2 = 0.04
my_constants.dt = 0.02 * dz^2 / chi

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 2
amr.n_cell = nr nz
amr.max_grid_size = 16
amr.max_level = 0

geometry.dims = RZ
warpx.n_rz_azimuthal_modes = 1
geometry.prob_lo = 0.0 -0.5*Lz
geometry.prob_hi = Lr 0.5*Lz
boundary.field_lo = none none
boundary.field_hi = pec none
boundary.particle_lo = none absorbing
boundary.particle_hi = reflecting absorbing

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 1.0

newton.verbose = true
newton.absolute_tolerance = 1.0e-12
newton.relative_tolerance = 1.0e-10
newton.max_iterations = 20
newton.diagnostic_file = diags/newton.txt

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-12
gmres.max_iterations = 300

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = T0_ev
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = 0.0
implicit_mhd.mass_density_floor = 1.0e-4 * rho0
implicit_mhd.electron_pressure_floor = 1.0e-6 * n0 * Twall_ev * q_e
implicit_mhd.evolve_ion_fluid = false
implicit_mhd.fluid_flux = central
# central-flux stabilization guard; inert here (frozen ions, u = 0)
implicit_mhd.viscosity = 1.0
implicit_mhd.include_joule_heating = false
implicit_mhd.thermal_diffusivity_electron = chi
implicit_mhd.mass_density(x,y,z) = rho0
implicit_mhd.electron_pressure(x,y,z) = n0 * q_e * T0_ev

# Contour stepping inward AT the z_hi plane.
implicit_mhd.wall_model = pec
implicit_mhd.wall_polyline_file = wall_step_at_zhi_r30_r20.csv
implicit_mhd.wall_thermal_bc = dirichlet
implicit_mhd.wall_temperature = Twall_ev

implicit_mhd.z_boundary_fluid = wall_temperature
implicit_mhd.z_wall_temperature = Tzend_ev
implicit_mhd.z_wall_conduction = 1

warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.0 0.0 B0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 2
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = implicit_mhd_mass_density \
                       implicit_mhd_electron_energy
diag1.write_species = 0
