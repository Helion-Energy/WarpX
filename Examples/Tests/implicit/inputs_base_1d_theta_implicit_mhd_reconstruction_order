#################################
############ CONSTANTS ##########
#################################

# Order-of-accuracy base deck for implicit_mhd.fluid_reconstruction.
#
# A pure CONTACT: uniform velocity, uniform ion and electron pressure,
# and a single-wavelength sine density perturbation. The exact solution
# is the initial profile translated by velocity * t -- no wave steepens,
# no pressure gradient develops -- so every deviation the run shows is
# numerical, and the ADVECTIVE truncation error is isolated from the
# acoustic and magnetic channels.
#
# The refinement family overrides my_constants.nz (32 / 64 / 128) and
# implicit_mhd.fluid_reconstruction from the CMake test registration.
# dt is deliberately keyed to the FINEST grid and held FIXED across the
# family, so the theta = 0.5 temporal error is a common constant of
# every arm and the measured order is purely spatial.

my_constants.n0 = 1.0e20
my_constants.rho0 = n0 * m_p
my_constants.drho = 0.2 * rho0
my_constants.Te = 10.0
my_constants.Pe = n0 * Te * q_e
my_constants.Pi = Pe
my_constants.gamma = 5.0/3.0
# Mach ~ 0.53: SUBSONIC, so the HLLD fan straddles the contact and the
# kappa_contact-smoothed region selection leaks fast-speed dissipation
# onto it -- the production regime the parity audit's D ~ c_f dx / 2
# sizing is about. A supersonic contact would degenerate to pure upwind
# and dissipate at |u| dx / 2 instead, which is not the claim under test.
my_constants.velocity = 3.0e4
my_constants.B0 = 1.0e-3
my_constants.nz = 32
my_constants.nz_ref = 128
my_constants.Lz = 1.0
my_constants.sound_speed = sqrt(gamma*(Pe+Pi)/rho0)
my_constants.dt = 0.5 * (Lz/nz_ref) / (velocity + sound_speed)

#################################
####### GENERAL PARAMETERS ######
#################################

max_step = 100
amr.n_cell = nz
amr.max_grid_size = 128
amr.max_level = 0

geometry.dims = 1
geometry.prob_lo = 0.0
geometry.prob_hi = Lz
boundary.field_lo = periodic
boundary.field_hi = periodic

#################################
############ NUMERICS ###########
#################################

warpx.abort_on_warning_threshold = high
warpx.verbose = 1
warpx.const_dt = dt
algo.maxwell_solver = hybrid
algo.current_deposition = direct
algo.evolve_scheme = theta_implicit_mhd

implicit_evolve.nonlinear_solver = newton
implicit_evolve.theta = 0.5

# Converged seven orders below the discretization error the study
# measures (~1e-3 relative at the coarse grid), so the nonlinear and
# linear solves contribute nothing to the observed order.
newton.verbose = false
newton.absolute_tolerance = 0.0
newton.relative_tolerance = 1.0e-8
newton.max_iterations = 20

gmres.verbose_int = 0
gmres.relative_tolerance = 1.0e-8
gmres.max_iterations = 100

# The block preconditioner is deliberately ON. It cannot move the
# converged solution (it only changes the Krylov path to the same
# Newton tolerance), it is what production runs, and it exercises the
# reconstruction against a preconditioner that is deliberately left at
# the donor-cell three-point stencil while the residual's fluid stencil
# is five-point -- the standard first-order-PC-for-a-second-order-
# operator construction the kernel documents.
jacobian.pc_type = pc_mhd_block

#################################
######### HYBRID OHM LAW ########
#################################

hybrid_pic_model.elec_temp = Te
hybrid_pic_model.n0_ref = n0
hybrid_pic_model.gamma = gamma
hybrid_pic_model.n_floor = 1.0e10
hybrid_pic_model.plasma_resistivity(rho,J,t) = 0.0
hybrid_pic_model.include_hall_term = false
hybrid_pic_model.include_electron_pressure_term = false

#################################
######## IMPLICIT MHD STATE #####
#################################

implicit_mhd.reference_mass_density = rho0
implicit_mhd.reference_velocity = velocity
implicit_mhd.reference_magnetic_field = B0
implicit_mhd.gamma_e = gamma
implicit_mhd.gamma_i = gamma
implicit_mhd.reference_ion_pressure = Pi
implicit_mhd.ion_closure = total_energy
implicit_mhd.mass_density_floor = 1.0e-6 * rho0
implicit_mhd.ion_pressure_floor = 1.0e-9 * Pi
implicit_mhd.electron_pressure_floor = 1.0e-9 * Pe
implicit_mhd.fluid_flux = hlld
implicit_mhd.allow_hlld = true   # the limiter needs an UPWIND flux
# implicit_mhd.fluid_reconstruction is set per arm from the command line.

implicit_mhd.mass_density(x,y,z) = "rho0 + drho * sin(2*pi*z/Lz)"
implicit_mhd.ion_pressure(x,y,z) = Pi
implicit_mhd.electron_pressure(x,y,z) = Pe
implicit_mhd.velocity_z(x,y,z) = velocity

# A uniform field along the flow keeps u x B = 0, so the electromagnetic
# subsystem stays exactly quiescent and only the fluid advection runs.
warpx.B_ext_grid_init_style = constant
warpx.B_external_grid = 0.0 0.0 B0

#################################
########### DIAGNOSTICS #########
#################################

diagnostics.diags_names = diag1
diag1.intervals = 100
diag1.diag_type = Full
diag1.format = plotfile
diag1.file_prefix = diags/diag
diag1.fields_to_plot = implicit_mhd_mass_density implicit_mhd_electron_energy
diag1.write_species = 0
