# Ballistic two-beam test of the ParticleBoundaryFlux reduced diagnostic:
# no field solver, cold protons drift out through z_hi and cold electrons
# through z_lo. The cumulative per-face weight/charge/energy columns must
# close against ParticleEnergy at every step.
max_step = 150
warpx.const_dt = 5.0e-10

amr.n_cell = 16 64
amr.max_level = 0
amr.blocking_factor = 8
amr.max_grid_size = 32

geometry.dims = RZ
geometry.prob_lo = 0.0 -0.2
geometry.prob_hi = 0.1  0.2

boundary.field_lo = none pec
boundary.field_hi = pec pec
boundary.particle_lo = none absorbing
boundary.particle_hi = absorbing absorbing

# Do not evolve the E and B fields: particles stream ballistically, so the
# boundary tallies must close against the particle energy exactly.
algo.maxwell_solver = none
algo.field_gathering = momentum-conserving
algo.particle_shape = 1

particles.species_names = protons electrons

protons.charge = q_e
protons.mass = m_p
protons.injection_style = "NUniformPerCell"
protons.num_particles_per_cell_each_dim = 2 4 2
protons.profile = constant
protons.density = 1.0e14
protons.xmax = 0.05
protons.zmin = -0.1
protons.zmax = 0.1
protons.momentum_distribution_type = constant
protons.ux = 0.0
protons.uy = 0.0
protons.uz = 0.02

electrons.charge = -q_e
electrons.mass = m_e
electrons.injection_style = "NUniformPerCell"
electrons.num_particles_per_cell_each_dim = 2 4 2
electrons.profile = constant
electrons.density = 1.0e14
electrons.xmax = 0.05
electrons.zmin = -0.1
electrons.zmax = 0.1
electrons.momentum_distribution_type = constant
electrons.ux = 0.0
electrons.uy = 0.0
electrons.uz = -0.02

diagnostics.diags_names = diag1
diag1.intervals = 150
diag1.diag_type = Full
diag1.fields_to_plot = Er

warpx.reduced_diags_names = PE PBF
PE.type = ParticleEnergy
PE.intervals = 1
PBF.type = ParticleBoundaryFlux
PBF.intervals = 1

authors = "The WarpX Community"
